{
  "name": "r7-orbit-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/media.mjs check && astro build && node scripts/media.mjs dist && node scripts/no-contact.mjs && node scripts/search-index.mjs",
    "media:check": "node scripts/media.mjs check",
    "preview": "astro preview",
    "check": "astro check",
    "check:layout": "node scripts/check-layout.mjs",
    "lint": "eslint .",
    "cms": "node scripts/cms.mjs",
    "waitlist:export": "node scripts/waitlist-export.mjs",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"src/**/*.test.ts\" && vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node tests/lighthouse.mjs",
    "runner:bots": "node scripts/runner-bots.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "astro": "^7.3.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "decap-cms-app": "^3.16.3",
    "decap-server": "^3.11.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
