---
// BlogPosting (blog) or NewsArticle (news) plus a BreadcrumbList. The author is a Person, or an Organization for an agent (lib/authors.ts);
// profile URLs come from site.json, and empty ones are left out, and so is anything else that is empty.
import { site } from '../data/site';
import { authorLd, type Author } from '../lib/authors';
import { profileUrls, prune } from '../lib/seo';
import { isoDate, plainTitle } from '../lib/text';

interface Props {
  kind: 'blog' | 'news';
  title: string;
  description: string;
  url: string;
  base: string;
  published: Date;
  modified?: Date;
  tags: string[];
  /** Absolute URL of the cover, if the post has one. */
  image?: string;
  minutes?: number;
  /** News only: the thing being discussed. */
  sourceUrl?: string;
  author: Author;
}

const { kind, title, description, url, base, published, modified, tags, image, minutes, sourceUrl, author } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': kind === 'news' ? 'NewsArticle' : 'BlogPosting',
      headline: plainTitle(title),
      description,
      datePublished: isoDate(published),
      ...(modified ? { dateModified: isoDate(modified) } : {}),
      ...(image ? { image: [image] } : {}),
      author: prune(authorLd(author, base, profileUrls(site.links))),
      publisher: { '@type': 'Organization', name: site.name, url: new URL('/', base).href },
      mainEntityOfPage: url,
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      ...(minutes ? { timeRequired: `PT${minutes}M` } : {}),
      ...(sourceUrl ? { isBasedOn: sourceUrl } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', base).href },
        { '@type': 'ListItem', position: 2, name: kind === 'news' ? 'News' : 'Blog', item: new URL(`/${kind}/`, base).href },
        { '@type': 'ListItem', position: 3, name: plainTitle(title), item: url },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
