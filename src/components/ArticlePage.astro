---
// The whole page for a blog post or a news item (docs/PAGES.md). The two routes only fetch and pass data, and so does the tests'
// fixture page (/styleguide/posts/<kind>/). A post written as sections (docs/SECTIONS.md) has them drawn where the Markdown body goes;
// its contents list and reading time come from the same projection (src/lib/sections-to-content.ts).
import type { ImageMetadata } from 'astro';
import ArticleHero from './ArticleHero.astro';
import ArticleJsonLd from './ArticleJsonLd.astro';
import CardMedia from './CardMedia.astro';
import NewsSignal from './NewsSignal.astro';
import AuthorByline from './AuthorByline.astro';
import Icon from './Icon.astro';
import PreviewBadge from './PreviewBadge.astro';
import PrevNext from './PrevNext.astro';
import RelatedPosts from './RelatedPosts.astro';
import Sections from './Sections.astro';
import SeriesNav from './SeriesNav.astro';
import ShareRow from './ShareRow.astro';
import TableOfContents from './TableOfContents.astro';
import WaitlistForm from './WaitlistForm.astro';
import { articleComponents } from './article/mdx';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { assistNote, authorSlugOf } from '../lib/authors';
import { getAuthorMap } from '../lib/authors-queries';
import { adjacentPosts, readTime, relatedPosts, seriesFor } from '../lib/content';
import type { SitePost } from '../lib/content-queries';
import { imageCreditHref, imageCreditName } from '../lib/image-credit';
import type { NewsTopic } from '../lib/news-signal';
import { motionOf } from '../lib/post-cards';
import { hasSections, sectionsHeadings } from '../lib/sections-to-content';
import { absoluteUrl, isoDate, longDate, plainTitle, titleParts } from '../lib/text';
import { headTitleFor } from '../lib/seo';
import { sourceForKind } from '../lib/waitlist';
import { waitlist } from '../lib/waitlist-queries';
import { getImage } from 'astro:assets';
import { publicSrcset } from '../lib/media-srcset';
import { render } from 'astro:content';
import ImageZoom from './ImageZoom.astro';
import '../styles/markdown.css';

interface Props {
  post: SitePost<'blog'> | SitePost<'news'>;
  /** Published posts of the same kind, newest first. */
  sameKind: SitePost<'blog'>[] | SitePost<'news'>[];
  /** Published posts of every kind, for related posts. */
  everything: SitePost[];
  /** The tests' fixture page: kept out of search engines. */
  noindex?: boolean;
}

const { post, sameKind, everything, noindex = false } = Astro.props;
const kind = post.collection as 'blog' | 'news';
const { data } = post;
// The body: the sections when the post has any (then the Markdown body is empty: getPosts checks), else the Markdown.
const sections = hasSections(data) ? (data.sections ?? []) : undefined;
const { Content, headings } = sections
  ? { Content: undefined, headings: sectionsHeadings(sections) }
  : await render(post.entry as never);

// <title> and og:title stay within 60 characters with the site name added (docs/PAGES.md); the h1 keeps the full headline.
function headTitle(title: string): string {
  const room = 60 - ' · '.length - site.name.length;
  const plain = plainTitle(title);
  if (plain.length <= room) return title;
  return plain.slice(0, room - 1).replace(/\s+\S*$/, '') + '…';
}

const label = kind === 'news' ? 'News' : 'Blog';
const minutes = readTime(post);
const base = (Astro.site ?? new URL(site.url)).href;
const url = absoluteUrl(Astro.url.pathname, base);
// The cover: the card's picture and the og:image. A blog post never draws it on the page (its featured image does that job);
// a news item draws it at the top, the same picture as its card (newsHero below).
const cover = data.cover ? { src: data.cover, alt: data.coverAlt ?? '' } : undefined;
// Blog only: an optional hero image behind the headline. It is also the og:image (a blog post has no separate cover; one left in
// an older post's file is used only when there is no featured image).
const featured = (data as { featuredImage?: ImageMetadata }).featuredImage;
const featuredAlt = (data as { featuredImageAlt?: string }).featuredImageAlt ?? '';
const featuredOg = featured ? await getImage({ src: featured, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const image = featuredOg ? new URL(featuredOg.src, base).href : cover ? new URL(cover.src, base).href : undefined;
const imageAlt = featuredOg ? featuredAlt : cover ? cover.alt : undefined;

const toc = kind === 'blog' && (data as { toc?: boolean }).toc !== false && (
  (data as { toc?: boolean }).toc === true || headings.filter((h) => h.depth === 2).length >= 3
);
const series = kind === 'blog' ? seriesFor(post, sameKind as SitePost<'blog'>[]) : undefined;
const { newer, older } = adjacentPosts(post, sameKind as SitePost[]);
const related = relatedPosts(post, everything);
const news = kind === 'news' ? (data as unknown as { sourceUrl: string; sourceName: string; take?: string; topic?: NewsTopic; symbol?: string; cover?: string }) : undefined;
// A news item opens with the same picture as its card: its cover (an official image, a screenshot of the source document or a
// Studio scene), credited and linked: to the agent's page when an agent made it (Pictor), otherwise to the source. Without a
// cover, the topic's picture as a slim banner.
const newsCredit = news ? (data as { coverCredit?: string }).coverCredit : undefined;
const newsHero = news && cover ? { ...cover, srcset: await publicSrcset(cover.src) } : undefined;
const newsBanner = news?.topic && !newsHero ? news.topic : undefined;

const authorMap = await getAuthorMap();
const author = authorMap.get(authorSlugOf(post))!;
const newsCreditHref = newsCredit ? ([...authorMap.values()].find((a) => a.name === newsCredit)?.path ?? news?.sourceUrl) : undefined;
const assist = assistNote(data.aiAssist, author);
const showWaitlist = data.waitlist && waitlist.show;
// "Image by" the site's owner by default, not the post's author (who may be an agent).
const creditData = data as Parameters<typeof imageCreditName>[0];
const credit = featured ? imageCreditName(creditData, site.author.name) : undefined;
const creditHref = featured ? imageCreditHref(creditData, site.author.name, [...authorMap.values()].filter((a) => a.kind === 'agent')) : undefined;
// The same picture, small, above "On this page" in the sidebar (wide screens only, where the sidebar is drawn), so it is seen
// clearly and not only behind the headline. With a hover clip it plays on hover like a card (card-motion.js). Decorative: the hero
// already carries the alt text. It is also a link to the picture at full size: image-zoom.js opens it in the post's picture dialog
// (ImageZoom.astro), first, before the body's pictures; without JavaScript the link opens the file itself.
// Where the sidebar is not drawn (narrower than 1200px, or a post without contents), the same picture opens the article instead,
// full width above the text (topPicture): on a phone the headline's picture is only a dim veil, so this is where it is seen.
const sidePicture = featured && toc ? await getImage({ src: featured, width: 640, height: 360, fit: 'cover', format: 'webp' }) : undefined;
const topPicture = featured ? await getImage({ src: featured, width: 1280, height: 720, fit: 'cover', format: 'webp' }) : undefined;
const fullPicture = featured ? await getImage({ src: featured, width: Math.min(featured.width, 1920), format: 'webp' }) : undefined;
const sideMotion = featured ? motionOf((data as { coverMotion?: string }).coverMotion, `${kind}/${post.id}`) : undefined;
const zoomLink = fullPicture && featured
  ? {
      href: fullPicture.src,
      'data-zoom-link': true,
      'data-zoom-alt': featuredAlt,
      'data-zoom-caption': credit ? `Image by ${credit}` : '',
      'data-zoom-width': featured.width,
      'data-zoom-height': featured.height,
      'aria-label': featuredAlt ? `Enlarge: ${featuredAlt}` : 'Enlarge the picture',
    }
  : undefined;
---

<BaseLayout
  title={data.seoTitle ? headTitleFor(data.title, data.seoTitle) : headTitle(data.title)}
  description={data.summary}
  ogType="article"
  image={image}
  imageAlt={imageAlt || undefined}
  published={data.date}
  modified={data.updated}
  tags={data.tags}
  current={`/${kind}/`}
  noindex={noindex}
>
  <ArticleJsonLd
    slot="head"
    kind={kind}
    title={data.title}
    description={data.summary}
    url={url}
    base={base}
    published={data.date}
    modified={data.updated}
    tags={data.tags}
    image={image}
    minutes={minutes}
    sourceUrl={news?.sourceUrl}
    author={author}
  />

  <div class="reading-progress" aria-hidden="true"></div>

  <ArticleHero image={featured} alt={featuredAlt} credit={credit} creditHref={creditHref}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={`/${kind}/`}>{label}</a></li>
        <li aria-current="page">{plainTitle(data.title)}</li>
      </ol>
    </nav>

    <header class="post-head">
      <p class="eyebrow">
        <span class="kind"><Icon name={kind} />{label}</span>
        <PreviewBadge post={post} />
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
      </p>
      <h1>{titleParts(data.title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <p class="t-lead">{data.summary}</p>
      <div class="byline">
        <AuthorByline author={author} />
        <span class="meta-item"><Icon name="calendar" /><time datetime={isoDate(data.date)}>{longDate(data.date)}</time></span>
        <span class="meta-item"><Icon name="clock" />{minutes} min read</span>
        {data.updated && (
          <span class="meta-item">Updated <time datetime={isoDate(data.updated)}>{longDate(data.updated)}</time></span>
        )}
        {data.tags.length > 0 && (
          <div class="cluster tags" aria-label="Tags">
            {data.tags.map((tag) => <a class="chip link" href={`/tags/${tag}/`}>{tag}</a>)}
          </div>
        )}
      </div>
      {assist && <p class="how-made"><strong>How this was made.</strong> {assist}</p>}
    </header>
  </ArticleHero>

  <!-- A blog post's cover is not drawn on the page (its picture is the featured image behind the headline); a news item's is,
       at the top of the column (newsHero), the same picture as its card (docs/CONTENT_MODEL.md, `cover`). -->
  <div class="container">
    <div class="post-layout">
      <div class="post-main">
        {topPicture && zoomLink && (
          <div class="post-picture">
            <a class="toc-picture-open" {...zoomLink}>
              <CardMedia cover={{ src: topPicture.src, alt: '', width: 1280, height: 720, motion: sideMotion }}>
                <span class="toc-picture-hint" aria-hidden="true"><Icon name="expand" small /></span>
              </CardMedia>
            </a>
          </div>
        )}
        {toc && <TableOfContents headings={headings} variant="inline" />}

        {newsHero && (
          <figure class="news-hero">
            <img src={newsHero.src} srcset={newsHero.srcset} sizes="(min-width: 900px) 720px, 92vw" alt={newsHero.alt} width="1600" height="900" fetchpriority="high" />
            {newsCredit && (
              <figcaption>
                Image: <a href={newsCreditHref} rel={newsCreditHref?.startsWith('http') ? 'noopener' : undefined}>{newsCredit}</a>
              </figcaption>
            )}
          </figure>
        )}

        {newsBanner && (
          <div class="news-banner">
            <NewsSignal topic={newsBanner} symbol={news?.symbol} seed={Astro.url.pathname} variant="banner" />
          </div>
        )}

        {news && (
          <aside class="source-box" aria-label="Source">
            <p class="eyebrow">Source</p>
            <p class="source-link">
              <a href={news.sourceUrl} rel="noopener">{news.sourceName}<Icon name="external" /></a>
            </p>
            {news.take && <p class="source-take"><span>My read:</span> {news.take}</p>}
          </aside>
        )}

        {
          sections ? (
            <article id="article">
              <Sections sections={sections} source={post.entry.filePath ?? `${kind}/${post.id}`} layout="column" headingIds />
            </article>
          ) : (
            Content && (
              <article class="prose" id="article">
                <Content components={articleComponents} />
              </article>
            )
          )
        }

        {series && <SeriesNav series={series} />}

        <ShareRow />
      </div>

      {toc && (
        <TableOfContents headings={headings} variant="aside">
          {sidePicture && (
            <div slot="before" class="toc-picture">
              <a class="toc-picture-open" {...zoomLink}>
                <CardMedia cover={{ src: sidePicture.src, alt: '', width: 640, height: 360, motion: sideMotion }}>
                  <span class="toc-picture-hint" aria-hidden="true"><Icon name="expand" small /></span>
                </CardMedia>
              </a>
            </div>
          )}
        </TableOfContents>
      )}
    </div>
  </div>

  {showWaitlist && <WaitlistForm variant="band" source={sourceForKind(kind)} />}

  <RelatedPosts posts={related} />

  <div class="container post-nav-wrap">
    <PrevNext newer={newer} older={older} />
  </div>

  <ImageZoom />
</BaseLayout>
