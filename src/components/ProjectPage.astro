---
// The whole page for a project (docs/PAGES.md): the route (src/pages/projects/[slug].astro) only fetches and passes data, and so does
// the tests' fixture page (/styleguide/posts/projects/). The write-up is the Markdown body, or the post's sections when it is written
// as blocks (docs/SECTIONS.md); the play section, gallery, changelog and facts come from the front matter either way.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorByline from './AuthorByline.astro';
import AuthorNote from './AuthorNote.astro';
import AppGrid from './AppGrid.astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import PreviewBadge from './PreviewBadge.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import PlayableBadge from './PlayableBadge.astro';
import PlayPanel from './PlayPanel.astro';
import PostCard from './PostCard.astro';
import ProjectJsonLd from './ProjectJsonLd.astro';
import Sections from './Sections.astro';
import StatusMark from './StatusMark.astro';
import WaitlistForm from './WaitlistForm.astro';
import { localImage, toCard, type ProjectData, type RepoData } from './detailCards';
import { authorSlugOf } from '../lib/authors';
import { getAuthorMap } from '../lib/authors-queries';
import type { SitePost } from '../lib/content-queries';
import { relatedPosts } from '../lib/content';
import { loadGitHubRepo } from '../lib/github';
import { toAppCards } from '../lib/app-cards';
import { APP_TYPES } from '../lib/app-types';
import { APPS_PATH, typeOf } from '../lib/apps';
import { isPlayable } from '../lib/play';
import { hasSections } from '../lib/sections-to-content';
import { headTitleFor } from '../lib/seo';
import { waitlist } from '../lib/waitlist-queries';
import { isoDate, longDate, plainTitle, titleParts } from '../lib/text';
import '../styles/markdown.css';

interface Props {
  post: SitePost<'projects'>;
  /** Published posts of every kind, newest first: related posts and the repo page this project's code is on. */
  all: SitePost[];
  /** Published apps (games and apps) in hub order, for the "More apps" strip under a playable project. */
  apps: SitePost<'projects'>[];
  /** The tests' fixture page: kept out of search engines. */
  noindex?: boolean;
}

const { post, all, apps, noindex = false } = Astro.props;
const data = post.entry.data as unknown as ProjectData;
// The write-up: the sections when the project has any (then the Markdown body is empty: getPosts checks), else the Markdown.
const sections = hasSections(data) ? (data.sections ?? []) : undefined;
const { Content } = sections ? { Content: undefined } : await render(post.entry);
const author = (await getAuthorMap()).get(authorSlugOf(post))!;

const repos = all.filter((p): p is SitePost<'repos'> => p.collection === 'repos');
const related = relatedPosts(post, all);
// The waitlist band after the body, before the related posts: asked for by the post and shown only while the waitlist is on.
const showWaitlist = post.data.waitlist && waitlist.show;

// Source: this site's repo page when there is one, else the repo URL, else the GitHub address of `repo`.
const repoName = data.repo?.toLowerCase();
const repoPage = repoName ? repos.find((r) => (r.entry.data as unknown as RepoData).repo.toLowerCase() === repoName) : undefined;
const githubUrl = data.repoUrl ?? (data.repo ? `https://github.com/${data.repo}` : undefined);
const source = repoPage
  ? { href: `/repos/${repoPage.id}/`, external: false }
  : githubUrl
    ? { href: githubUrl, external: true }
    : undefined;

// The licence comes from the GitHub loader; nothing is shown when it has no data.
const gh = data.repo ? await loadGitHubRepo(data.repo) : undefined;
const license = gh?.status === 'ok' ? gh.stats.license : null;

const cover = localImage(data.cover);
const shots = data.gallery.map((shot) => ({ src: localImage(shot.src), alt: shot.alt, caption: shot.caption }));
const timeline = [...data.timeline].sort((a, b) => b.date.getTime() - a.date.getTime());

const playable = isPlayable(data);
const embedded = playable && data.playMode !== 'link';
const playProps = data.playUrl
  ? {
      playUrl: data.playUrl,
      title: plainTitle(data.title),
      poster: cover,
      playMode: data.playMode,
      playAspect: data.playAspect,
      controls: data.controls,
      playNote: data.playNote,
      platforms: data.platforms,
    }
  : undefined;
// The other apps of any type, for the strip under a playable project (up to three; the link to /apps/ shows even with none).
const moreApps = playable ? toAppCards(apps.filter((a) => a.id !== post.id).slice(0, 3)) : [];
// Game or app (src/lib/app-types.ts): its structured data and its label in search results.
const appType = playable ? typeOf(post) : undefined;
const hasBody = Boolean(sections) || Boolean(post.body?.trim());
const path = `/projects/${post.id}/`;
---

<BaseLayout
  title={headTitleFor(data.title, data.seoTitle)}
  description={data.summary}
  current="/projects/"
  noindex={noindex}
  published={data.date}
  modified={data.updated}
  tags={data.tags}
>
  <ProjectJsonLd
    slot="head"
    kind="project"
    name={data.title}
    description={data.summary}
    path={path}
    published={data.date}
    modified={data.updated}
    keywords={[...data.stack, ...data.tags]}
    liveUrl={data.liveUrl}
    codeRepository={githubUrl}
    playUrl={data.playUrl}
    appType={appType}
    author={author}
  />
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li aria-current="page">{plainTitle(data.title)}</li>
      </ol>
    </nav>

    <header class="project-head">
      {/* A playable project's result in search reads as its type (src/scripts/search.js); one Pagefind meta key per element. */}
      <p class="eyebrow" data-pagefind-meta={appType ? `kind:${APP_TYPES[appType].label}` : undefined}>
        <span class="kind" data-pagefind-meta={appType ? `kindIcon:${APP_TYPES[appType].icon}` : undefined}><Icon name="project" />Project</span>
        {playable && <PlayableBadge />}
        <PreviewBadge post={post} />
      </p>
      <h1>{titleParts(data.title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <p class="t-lead">{data.summary}</p>
      <p class="post-author"><AuthorByline author={author} /></p>
      <p class="status-line"><StatusMark status={data.status} /></p>
      {
        data.stack.length > 0 && (
          <div class="cluster" aria-label="Built with">
            {data.stack.map((item) => (
              <span class="chip mono">{item}</span>
            ))}
          </div>
        )
      }
      {
        (playable || data.liveUrl || source) && (
          <div class="cluster actions">
            {playable && (
              <a class="btn solid" href={embedded ? '#play' : data.playUrl} target={embedded ? undefined : '_blank'} rel={embedded ? undefined : 'noopener'}>
                <Icon name="play" />Play
              </a>
            )}
            {data.liveUrl && (
              <a class={playable ? 'btn' : 'btn solid'} href={data.liveUrl} rel="noopener">
                Live site<Icon name="external" />
              </a>
            )}
            {source && (
              <a class={playable || data.liveUrl ? 'btn' : 'btn solid'} href={source.href} rel={source.external ? 'noopener' : undefined}>
                <Icon name="github" />Source repo{source.external && <Icon name="external" />}
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      !embedded && (
        <div class="media framed">
          {cover ? <img src={cover} alt={data.coverAlt ?? ''} width="1280" height="720" decoding="async" /> : <MediaPlaceholder />}
        </div>
      )
    }
    {
      playProps && (
        <div id="play">
          <PlayPanel {...playProps} />
        </div>
      )
    }

    <div class="split">
      <div>
        {
          hasBody && (
            <section class="block" aria-label="Write-up">
              {sections ? (
                <Sections sections={sections} source={post.entry.filePath ?? `projects/${post.id}`} layout="column" headingIds />
              ) : (
                Content && (
                  <div class="prose">
                    <Content />
                  </div>
                )
              )}
            </section>
          )
        }

        {
          shots.length > 0 && (
            <section class="block" aria-labelledby="shots-h">
              <h2 class="section-title" id="shots-h">Screenshots</h2>
              <Gallery shots={shots} label={`${plainTitle(data.title)} screenshots`} />
            </section>
          )
        }

        {
          timeline.length > 0 && (
            <section class="block" aria-labelledby="changelog-h">
              <h2 class="section-title" id="changelog-h">Changelog</h2>
              <ol class="timeline">
                {timeline.map((item) => (
                  <li>
                    <time datetime={isoDate(item.date)}>{isoDate(item.date)}</time>
                    <p>{item.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <AuthorNote author={author} />
      </div>

      <aside class="sticky" aria-label="Project facts">
        <div class="facts">
          <h2 class="eyebrow">Facts</h2>
          <dl>
            <div><dt>Status</dt><dd><StatusMark status={data.status} /></dd></div>
            {
              data.started && (
                <div><dt>Started</dt><dd class="mono"><time datetime={isoDate(data.started)}>{longDate(data.started)}</time></dd></div>
              )
            }
            {
              data.shipped && (
                <div><dt>Shipped</dt><dd class="mono"><time datetime={isoDate(data.shipped)}>{longDate(data.shipped)}</time></dd></div>
              )
            }
            {data.role && <div><dt>Role</dt><dd>{data.role}</dd></div>}
            {
              data.stack.length > 0 && (
                <div>
                  <dt>Stack</dt>
                  <dd>
                    <div class="cluster">
                      {data.stack.map((item) => (
                        <span class="chip mono">{item}</span>
                      ))}
                    </div>
                  </dd>
                </div>
              )
            }
            {license && <div><dt>License</dt><dd>{license}</dd></div>}
            {
              (data.liveUrl || source) && (
                <div>
                  <dt>Links</dt>
                  <dd class="facts-links">
                    {data.liveUrl && (
                      <a href={data.liveUrl} rel="noopener">
                        Live site<Icon name="external" small />
                      </a>
                    )}
                    {source && (
                      <a href={source.href} rel={source.external ? 'noopener' : undefined}>
                        Source repo<Icon name={source.external ? 'external' : 'arrow'} small />
                      </a>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </aside>
    </div>
  </div>

  {showWaitlist && <WaitlistForm variant="band" source="other" />}

  {
    related.length > 0 && (
      <section class="section ruled" aria-labelledby="related-h">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Writing about it</p>
              <h2 class="section-title" id="related-h">Related posts</h2>
            </div>
          </div>
          <div class="grid-cards">
            {related.map((item) => (
              <PostCard post={toCard(item)} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    playable && (
      <section class="section ruled" aria-labelledby="more-apps-h" data-more-apps>
        <div class="container">
          <div class:list={['section-head', moreApps.length === 0 && 'flush']}>
            <div>
              <p class="eyebrow">Play in the browser</p>
              <h2 class="section-title" id="more-apps-h">More apps</h2>
            </div>
            <a class="more-link" href={APPS_PATH}>
              All apps
              <Icon name="arrow" />
            </a>
          </div>
          {moreApps.length > 0 && <AppGrid apps={moreApps} level={3} />}
        </div>
      </section>
    )
  }
</BaseLayout>
