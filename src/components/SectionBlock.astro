---
// One block in the reading column of a page (Sections.astro): everything except a portrait or a wide image. It adds no wrapper
// element, so the blocks stay direct children of `.prose` and get its spacing.
import Callout from './article/Callout.astro';
import Divider from './article/Divider.astro';
import Figure from './article/Figure.astro';
import Quote from './article/Quote.astro';
import Icon from './Icon.astro';
import type { ProseBlock } from '../lib/page-sections';
import type { ImageSize } from '../lib/section-images';

interface Props {
  block: ProseBlock;
  /** The block's Markdown as sanitised HTML (text, quote, callout). */
  html?: string;
  /** The picture's size (image). */
  size?: ImageSize;
}

const { block, html = '', size } = Astro.props;
const external = (url: string) => url.startsWith('https://');
---

{block.type === 'heading' && (block.level === 3 ? <h3>{block.text}</h3> : <h2>{block.text}</h2>)}
{block.type === 'text' && <Fragment set:html={html} />}
{
  block.type === 'image' && (
    <Figure
      src={block.image}
      alt={block.decorative ? '' : block.alt}
      caption={block.caption || undefined}
      width={size?.width}
      height={size?.height}
    />
  )
}
{
  block.type === 'quote' && (
    <Quote cite={block.attribution || undefined}>
      <Fragment set:html={html} />
    </Quote>
  )
}
{
  block.type === 'callout' && (
    <Callout type={block.kind} title={block.title || undefined}>
      <Fragment set:html={html} />
    </Callout>
  )
}
{
  block.type === 'links' && (
    <ul class="link-list">
      {block.items.map((item) => (
        <li>
          <a href={item.url} rel={external(item.url) ? 'noopener' : undefined}>
            {item.label}
            {item.note && <span class="where">{item.note}</span>}
            <Icon name={external(item.url) ? 'external' : 'arrow'} />
          </a>
        </li>
      ))}
    </ul>
  )
}
{
  block.type === 'button' && (
    <p class="sec-button">
      <a class="btn solid" href={block.url} rel={external(block.url) ? 'noopener' : undefined}>
        {block.label}
        {external(block.url) && <Icon name="external" />}
      </a>
    </p>
  )
}
{block.type === 'divider' && <Divider variant={block.style} />}
