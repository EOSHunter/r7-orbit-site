---
// A round-cornered square: the person's photo, the agent's mark on the plate, or initials when there is no picture.
import { initials, isAgent, type Author } from '../lib/authors';

interface Props {
  author: Author;
  /** The bigger one on the author's own page. */
  large?: boolean;
}

const { author, large = false } = Astro.props;
const mark = isAgent(author);
const kind = author.avatar ? (mark ? 'mark' : 'photo') : 'initials';
---

<span class:list={['avatar', kind, large && 'lg']} aria-hidden="true">
  {author.avatar ? <img src={author.avatar} alt="" /> : <span>{initials(author.name)}</span>}
</span>
