---
// A round-cornered square: the person's photo, the agent's mark on the plate, an agent's own picture (a square that already
// carries its plate and rounded corners, so it fills the box), or initials when there is no picture.
// A photo from public/ comes with its small WebP copies (src/lib/media-srcset.ts), so a 32px avatar is not the 800px original.
// The picture sits beside the author's name, so it is decorative, except where it is drawn large and the author file says what it
// shows (`avatarAlt`): then it is read.
import { initials, isAgent, type Author } from '../lib/authors';
import { SIZES, publicSrcset } from '../lib/media-srcset';

interface Props {
  author: Author;
  /** The bigger one on the author's own page and in the Team block. */
  large?: boolean;
  /** Among a page's blocks (AuthorBox, the Team block): load it when it nears the screen. */
  lazy?: boolean;
  /** At the head of the author's own page, where it grows to the height of the text beside it (implies large). */
  head?: boolean;
}

const { author, head = false, lazy = false } = Astro.props;
const large = head || (Astro.props.large ?? false);
const mark = isAgent(author);
const own = mark && !!author.avatar?.startsWith('/media/');
const kind = author.avatar ? (own ? 'art' : mark ? 'mark' : 'photo') : 'initials';
const srcset = await publicSrcset(author.avatar);
const alt = (large && author.avatar && author.avatarAlt) || '';
---

<span class:list={['avatar', kind, large && 'lg']} aria-hidden={alt ? undefined : 'true'}>
  {author.avatar ? (
    <img
      src={author.avatar}
      srcset={srcset}
      sizes={srcset && (head ? SIZES.avatarHead : large ? SIZES.avatarLarge : SIZES.avatar)}
      alt={alt}
      loading={lazy ? 'lazy' : undefined}
    />
  ) : (
    <span>{initials(author.name)}</span>
  )}
</span>
