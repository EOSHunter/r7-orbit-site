---
// The whole page for a vlog (docs/PAGES.md): the route (src/pages/vlogs/[slug].astro) only fetches and passes data, and so does the
// tests' fixture page (/styleguide/posts/vlogs/). The notes under the video are the Markdown body, or the post's sections when it is
// written as blocks (docs/SECTIONS.md). The transcript is the body's `## Transcript` part (`transcript: true`), or, for a vlog written
// as sections, its `transcriptText`; either way it is shown folded.
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorByline from './AuthorByline.astro';
import AuthorNote from './AuthorNote.astro';
import Icon from './Icon.astro';
import PreviewBadge from './PreviewBadge.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import PostCard from './PostCard.astro';
import Sections from './Sections.astro';
import YouTubeFacade from './YouTubeFacade.astro';
import WaitlistForm from './WaitlistForm.astro';
import VideoJsonLd from './vlog/VideoJsonLd.astro';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { renderMarkdown, splitTranscript } from './vlog/renderNotes';
import { site } from '../data/site';
import { authorSlugOf } from '../lib/authors';
import { getAuthorMap } from '../lib/authors-queries';
import type { VlogCardData } from '../lib/cards';
import { adjacentPosts, postUrl, relatedPosts } from '../lib/content';
import type { SitePost } from '../lib/content-queries';
import { coverOf } from '../lib/post-cards';
import { hasSections } from '../lib/sections-to-content';
import { absoluteUrl, isoDate, longDate, plainTitle, titleParts } from '../lib/text';
import { headTitleFor } from '../lib/seo';
import { waitlist } from '../lib/waitlist-queries';
import '../styles/markdown.css';

// content.config.ts builds the vlog schema through a helper that widens the extra fields; this is their real shape.
interface VlogFields {
  youtubeId?: string;
  videoUrl?: string;
  duration: string;
  poster?: string;
  chapters?: { t: string; title: string }[];
  transcript?: boolean;
  transcriptText?: string;
}
type VlogData = SitePost<'vlogs'>['data'] & VlogFields;

interface Props {
  post: SitePost<'vlogs'>;
  /** Published vlogs, newest first: related videos and the previous and next one. */
  vlogs: SitePost<'vlogs'>[];
  /** The tests' fixture page: kept out of search engines. */
  noindex?: boolean;
}

const { post, vlogs, noindex = false } = Astro.props;
const data = post.data as VlogData;
const durationOf = (p: SitePost<'vlogs'>) => (p.data as VlogData).duration;
const title = plainTitle(data.title);
const base = Astro.site ?? new URL(site.url);
const author = (await getAuthorMap()).get(authorSlugOf(post))!;

// Written as sections: the blocks are the notes and `transcriptText` the transcript. Else both come from the Markdown body.
const sections = hasSections(data) ? (data.sections ?? []) : undefined;
const { notes, transcript } = sections
  ? { notes: '', transcript: data.transcriptText ?? '' }
  : data.transcript
    ? splitTranscript(post.body ?? '')
    : { notes: post.body ?? '', transcript: '' };
// The file's address, so an image with no alt text is reported with the vlog it is in.
const source = post.entry.filePath ? pathToFileURL(resolve(post.entry.filePath)) : undefined;
const [notesHtml, transcriptHtml] = await Promise.all([renderMarkdown(notes, source), renderMarkdown(transcript, source)]);

const poster = data.poster ?? data.cover;
const imageUrl = data.cover ? new URL(data.cover, base).href : undefined;

const card = (p: SitePost<'vlogs'>): VlogCardData => {
  const { poster, cover, coverAlt } = p.data as { poster?: string; cover?: string; coverAlt?: string };
  return {
    kind: 'vlog',
    href: postUrl(p),
    title: p.data.title,
    summary: p.data.summary,
    date: p.data.date,
    tags: p.data.tags,
    duration: durationOf(p),
    cover: coverOf({ cover: poster ?? cover, coverAlt }),
  };
};
const related = relatedPosts(post, vlogs, 3);
// The waitlist band after the body, before the related posts: asked for by the post and shown only while the waitlist is on.
const showWaitlist = post.data.waitlist && waitlist.show;
const { newer, older } = adjacentPosts(post, vlogs);
const youtube = site.links.youtube;

const breadcrumbs = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Vlogs', item: absoluteUrl('/vlogs/', base.href) },
    { '@type': 'ListItem', position: 3, name: title, item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={headTitleFor(data.title, data.seoTitle)}
  description={data.summary}
  ogType="video.other"
  image={data.cover}
  imageAlt={data.cover ? data.coverAlt || title : undefined}
  published={data.date}
  modified={data.updated}
  tags={data.tags}
  current="/vlogs/"
  noindex={noindex}
>
  <VideoJsonLd
    slot="head"
    name={title}
    description={data.summary}
    uploadDate={isoDate(data.date)}
    duration={data.duration}
    thumbnailUrl={imageUrl}
    youtubeId={data.youtubeId}
    videoUrl={data.videoUrl}
    chapters={data.chapters}
    author={author}
    base={base.href}
  />
  <script slot="head" type="application/ld+json" set:html={breadcrumbs} />

  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/vlogs/">Vlogs</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="post-head">
      <p class="eyebrow">
        <span class="kind"><Icon name="vlog" />Vlog</span>
        <PreviewBadge post={post} />
      </p>
      <h1>{titleParts(data.title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <ul class="meta-row" aria-label="Video details">
        <li><AuthorByline author={author} /></li>
        <li><Icon name="calendar" /><time datetime={isoDate(data.date)}>{longDate(data.date)}</time></li>
        <li><Icon name="clock" /><span>{data.duration}</span></li>
        {data.updated && <li>Updated <time datetime={isoDate(data.updated)}>{longDate(data.updated)}</time></li>}
        {
          data.tags.length > 0 && (
            <li>
              {data.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </li>
          )
        }
      </ul>
    </header>

    {
      data.youtubeId ? (
        <YouTubeFacade id={data.youtubeId} title={title} poster={poster} duration={data.duration} chapters={data.chapters} />
      ) : (
        <div class="player">
          <MediaPlaceholder />
          <a class="play" href={data.videoUrl} rel="noopener" aria-label={`Watch video on its own site: ${title}`}>
            <span><Icon name="play" /></span>
          </a>
          <span class="duration">{data.duration}</span>
        </div>
      )
    }

    <div class="split">
      <div>
        {
          sections ? (
            <section class="block" aria-labelledby="notes-h">
              <h2 class="section-title" id="notes-h">About this video</h2>
              <Sections sections={sections} source={post.entry.filePath ?? `vlogs/${post.id}`} layout="column" headingIds />
            </section>
          ) : (
            notesHtml && (
              <section class="block" aria-labelledby="notes-h">
                <h2 class="section-title" id="notes-h">About this video</h2>
                <div class="prose" set:html={notesHtml} />
              </section>
            )
          )
        }
        {
          transcriptHtml && (
            <section class="block" aria-labelledby="transcript-h">
              <h2 class="section-title" id="transcript-h">Transcript</h2>
              <details class="disclosure">
                <summary>Show the transcript</summary>
                <div class="inner prose" set:html={transcriptHtml} />
              </details>
            </section>
          )
        }
        <AuthorNote author={author} />
      </div>

      {
        youtube && (
          <aside class="sticky">
            <div class="facts">
              <h2 class="eyebrow">Follow along</h2>
              <div class="links">
                <a class="btn" href={youtube} rel="noopener">
                  <Icon name="vlog" />Subscribe on YouTube<Icon name="external" />
                </a>
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </div>

  {showWaitlist && <WaitlistForm variant="band" source="vlog" />}

  {
    related.length > 0 && (
      <section class="section ruled" aria-labelledby="related-h">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">More videos</p>
              <h2 class="section-title" id="related-h">Keep watching</h2>
            </div>
            <a class="more-link" href="/vlogs/">
              All videos<Icon name="arrow" />
            </a>
          </div>
          <div class="grid-cards">{related.map((p) => <PostCard post={card(p)} />)}</div>
        </div>
      </section>
    )
  }

  {
    (newer || older) && (
      <section class="section ruled" aria-label="Previous and next video">
        <div class="container">
          <nav class="post-nav" aria-label="Previous and next video">
            {older ? (
              <a class="prev" href={postUrl(older)} rel="prev">
                <span class="label-row">Older video</span>
                <span class="title">{plainTitle(older.data.title)}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="next" href={postUrl(newer)} rel="next">
                <span class="label-row">Newer video</span>
                <span class="title">{plainTitle(newer.data.title)}</span>
              </a>
            )}
          </nav>
        </div>
      </section>
    )
  }
</BaseLayout>
