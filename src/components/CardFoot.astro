---
// The line at the foot of a card: the date (or a label) and the minutes. No arrow: the whole card is the link, and the title
// turns brass on hover.
import { isoDate, shortDate } from '../lib/text';

interface Props {
  date?: Date | string;
  /** Text shown instead of a date, e.g. "Updated Oct 1". */
  label?: string;
  /** Minutes to read or watch, shown as "8 min". */
  minutes?: number;
}

const { date, label, minutes } = Astro.props;
---

<div class="card-foot">
  {label && <span>{label}</span>}
  {date && !label && <time datetime={isoDate(date)}>{shortDate(date)}</time>}
  {minutes !== undefined && (
    <>
      <span aria-hidden="true">&middot;</span>
      <span>{minutes} min</span>
    </>
  )}
  <slot />
</div>
