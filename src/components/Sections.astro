---
// Draws a page built from blocks (the `sections` list: the shared library in src/lib/sections/, docs/SECTIONS.md). Each block is the
// author's own words and pictures; this decides how they sit, and the block's own component (src/components/sections/) draws it.
// Reading-column blocks share one `.prose` column; a portrait puts its picture in a side column beside the text; a block that
// leaves the column (a wide or full image, a gallery, the latest posts, a game) gets a row of its own. Where
// each block sits is its definition's `placement`; the rows come from `layoutSections`, which the admin preview uses too.
//
// Used by src/pages/about.astro and the fixture page (`layout="page"`: rows the width of the window), by the home page (its rows), the
// archives, /games/ and /tags/ (the blocks above and below their list), also with `layout="page"`, and by the post pages for a post
// written as sections (`layout="column"`: the rows sit in the post's text column, beside its contents list or facts, so nothing
// reaches the window's edges and a Full image is as wide as the column). The admin preview draws the same rows from strings
// (src/admin/sections-html.ts).
import { layoutSections, SECTION_LABELS, type Section, type SectionOf } from '../lib/sections';
import { onceProblems, whereOf } from '../lib/sections/checks';
import { prepareSections } from '../lib/sections/prepare';
import HeadingBlock from './sections/HeadingBlock.astro';
import PortraitBlock from './sections/PortraitBlock.astro';
import { renderers } from './sections/registry';
import '../styles/markdown.css';
import '../styles/article.css';
import '../styles/sections.css';

interface Props {
  sections: readonly Section[];
  /** The page's file, for errors: "about.md". */
  source: string;
  /** `page` (default): each row in a page-wide container. `column`: inside a post's text column. */
  layout?: 'page' | 'column';
  /** Give every heading an anchor (a post's contents list links to them). A page with a Table of contents block always does. */
  headingIds?: boolean;
}

const { sections, source, layout = 'page', headingIds = false } = Astro.props;
const rowClass = layout === 'page' ? 'container wide sec-row' : 'sec-row';

// A block a page may hold once (the Latest feed: one #latest anchor, one kind filter), found twice, stops the build.
const [repeated] = onceProblems(sections.map((s) => s.type));
if (repeated) throw new Error(`${whereOf(source, repeated.index, SECTION_LABELS[sections[repeated.index].type])}: ${repeated.message}`);

// Everything the markup needs that takes a read or a render, done once up front: the Markdown of each text box (HTML,
// sanitised), the size of each picture (so the page reserves its space) and, with a table of contents, the headings.
const contexts = await prepareSections(sections, source, { headingIds, layout });

// Each block with the component that draws it and what it was prepared with, grouped into rows.
const draw = (block: Section) => ({ Block: renderers[block.type], block, ctx: contexts.get(block)! });
const rows = layoutSections(sections).map((r) =>
  r.kind === 'split'
    ? {
        kind: 'split' as const,
        portrait: r.portrait as SectionOf<'portrait'>,
        portraitCtx: contexts.get(r.portrait)!,
        lead: r.lead as SectionOf<'heading'> | undefined,
        leadCtx: r.lead && contexts.get(r.lead),
        blocks: r.blocks.map(draw),
      }
    : r.kind === 'prose'
      ? { kind: 'prose' as const, blocks: r.blocks.map(draw) }
      : // In a column nothing reaches the window's edges: a full row is a wide one.
        { kind: r.kind === 'full' && layout === 'column' ? ('wide' as const) : r.kind, ...draw(r.block) },
);
---

<div class="sections" data-layout={layout === 'column' ? 'column' : undefined}>
  {
    rows.map((row, index) =>
      row.kind === 'split' ? (
        <div class={rowClass}>
          <PortraitBlock block={row.portrait} ctx={row.portraitCtx} first={index === 0}>
            {row.lead && row.leadCtx && <HeadingBlock slot="lead" block={row.lead} ctx={row.leadCtx} />}
            {row.blocks.map(({ Block, block, ctx }) => <Block block={block} ctx={ctx} />)}
          </PortraitBlock>
        </div>
      ) : row.kind === 'prose' ? (
        <div class={rowClass}>
          <div class="prose">{row.blocks.map(({ Block, block, ctx }) => <Block block={block} ctx={ctx} />)}</div>
        </div>
      ) : row.kind === 'full' ? (
        <div class="sec-row sec-row-full"><row.Block block={row.block} ctx={row.ctx} /></div>
      ) : row.kind === 'band' ? (
        <div class="sec-row sec-row-band"><row.Block block={row.block} ctx={row.ctx} /></div>
      ) : (
        <div class={rowClass}><row.Block block={row.block} ctx={row.ctx} /></div>
      ),
    )
  }
</div>
