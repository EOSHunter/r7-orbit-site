---
// JSON-LD for the project page (SoftwareApplication; a playable project takes its types from its appType: a game is a VideoGame
// as well, an app a WebApplication, src/lib/app-types.ts) and the repo page (SoftwareSourceCode), plus a breadcrumb.
// Only fields that are known are written: no rating, price or category is made up. The author is a Person, or an Organization for an agent.
import { site } from '../data/site';
import { APP_TYPES, DEFAULT_APP_TYPE, type AppType } from '../lib/app-types';
import { authorLd, type Author } from '../lib/authors';
import { profileUrls, prune } from '../lib/seo';
import { isoDate, absoluteUrl, plainTitle } from '../lib/text';

interface Props {
  kind: 'project' | 'repo';
  name: string;
  description: string;
  /** Path of this page, e.g. /projects/r7-orbit/ */
  path: string;
  published?: Date | string;
  modified?: Date | string;
  keywords?: string[];
  /** Project: the live site or app. */
  liveUrl?: string;
  /** Project: the address of a game or app that runs in the browser. With it, the types and category come from `appType`. */
  playUrl?: string;
  /** Project: the type of a playable project (src/lib/app-types.ts). Left out, it is the default, an app. */
  appType?: AppType;
  /** Link to the code: the GitHub repo. */
  codeRepository?: string;
  language?: string | null;
  /** SPDX id, when GitHub reports one. */
  license?: string | null;
  author: Author;
}

const p = Astro.props;
const base = (Astro.site ?? new URL(site.url)).href;
const pageUrl = absoluteUrl(p.path, base);
const section = p.kind === 'project' ? { name: 'Projects', path: '/projects/' } : { name: 'Repos', path: '/repos/' };
const licenseUrl = p.license && /^[\w.+-]+$/.test(p.license) && p.license !== 'NOASSERTION' ? `https://spdx.org/licenses/${p.license}` : undefined;

// url is the play address when there is one, so the live site (if it is another address) goes to sameAs with the code.
const sameAs = [p.codeRepository, p.playUrl ? p.liveUrl : undefined].filter((u): u is string => Boolean(u));
const playable = p.playUrl ? APP_TYPES[p.appType ?? DEFAULT_APP_TYPE] : undefined;
const types = playable ? [...playable.ld] : [];

const main: Record<string, unknown> =
  p.kind === 'project'
    ? {
        '@type': types.length > 1 ? types : (types[0] ?? 'SoftwareApplication'),
        name: plainTitle(p.name),
        description: p.description,
        mainEntityOfPage: pageUrl,
        ...(p.playUrl || p.liveUrl ? { url: absoluteUrl((p.playUrl ?? p.liveUrl) as string, base) } : {}),
        ...(playable ? { applicationCategory: playable.category, operatingSystem: 'Web browser' } : {}),
        ...(sameAs.length ? { sameAs } : {}),
      }
    : {
        '@type': 'SoftwareSourceCode',
        name: p.name,
        description: p.description,
        url: pageUrl,
        ...(p.codeRepository ? { codeRepository: p.codeRepository } : {}),
        ...(p.language ? { programmingLanguage: p.language } : {}),
        ...(licenseUrl ? { license: licenseUrl } : {}),
      };
if (p.published) main.datePublished = isoDate(p.published);
if (p.modified) main.dateModified = isoDate(p.modified);
if (p.keywords?.length) main.keywords = p.keywords.join(', ');
main['author'] = prune(authorLd(p.author, base, profileUrls(site.links)));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    main,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base) },
        { '@type': 'ListItem', position: 2, name: section.name, item: absoluteUrl(section.path, base) },
        { '@type': 'ListItem', position: 3, name: plainTitle(p.name), item: pageUrl },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '<')} />
