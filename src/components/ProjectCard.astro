---
import CardMedia from './CardMedia.astro';
import Icon from './Icon.astro';
import PlayableBadge from './PlayableBadge.astro';
import PreviewBadge from './PreviewBadge.astro';
import StatusMark from './StatusMark.astro';
import { cardAttrs } from './cardAttrs';
import type { ProjectCardData } from '../lib/cards';
import { plainTitle } from '../lib/text';

interface Props {
  post: ProjectCardData;
}

const { post } = Astro.props;
// Kind (and "Playable"), title, one line and the status. The stack is the project page's, not the card's.
---

<a {...cardAttrs(post)}>
  <CardMedia cover={post.cover} />
  <div class="card-body">
    <div class="cluster">
      <span class="kind">
        <Icon name="project" />
        Project
      </span>
      {post.playable && <PlayableBadge />}
      {post.preview && <PreviewBadge label={post.preview} />}
    </div>
    <h3 class="card-title serif">{plainTitle(post.title)}</h3>
    <p class="card-text">{post.summary}</p>
    <div class="card-foot">
      <StatusMark status={post.status} />
    </div>
  </div>
</a>
