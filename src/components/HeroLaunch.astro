---
// The home page hero's picture (wide screens), three layers: R7 Orbit Studio's ring (src/assets/home/hero-launch.jpg, from
// authored/home-hero/layout.py), the moving layer (/media/home/hero-launch.svg, src/lib/hero-launch.ts: agents launch from the
// hub to the five projects, then the projects travel round the ring for as long as the page is open), and the R7 mark over the
// hub. No JavaScript. Both pictures come through <picture> sources for wide screens only, so a phone fetches nothing large
// (a 1px placeholder). Under reduced motion the picture is the still layer (/media/home/hero-launch-still.svg). Decorative: the headline says what the page is.
import { getImage } from 'astro:assets';
import art from '../assets/home/hero-launch.jpg';
import data from '../data/home-hero.json';

const [W, H] = data.canvas;
const [hx, hy] = data.hub;
const WIDE = '(min-width: 900px)';
const sizes = '(min-width: 1480px) 640px, (min-width: 900px) 46vw, 1px';
// WebP only: the art's grain makes AVIF larger than WebP here (measured 2026-11-07: 292 kB against 224 kB at 1280px).
const webp = await Promise.all([640, 960, 1280].map((width) => getImage({ src: art, width, format: 'webp', quality: 72 })));
const srcset = webp.map((img, i) => `${img.src} ${[640, 960, 1280][i]}w`).join(', ');
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
// The R7 mark (from scripts/orbit.js), 610 x 524 units, drawn about 250 wide over the hub.
const LOGO = [
  'M598 0H65L166 98.5H351.5L208 242V407.5L324.5 524V273.5L598 0Z',
  'M162 231.5L208 185.5H0C31.7749 216.5 95.9597 279.6 98.5 284C101.04 288.4 141.892 285.833 162 284V231.5Z',
  'M366.5 284L434.5 225L610 407.5H483L366.5 284Z',
];
const markScale = 250 / 610;
const mark = `translate(${hx - (610 * markScale) / 2} ${hy - (524 * markScale) / 2}) scale(${markScale})`;
---

<div class="hero-launch" aria-hidden="true">
  <picture>
    <source media={WIDE} type="image/webp" srcset={srcset} sizes={sizes} />
    <img class="hero-launch-art" src={BLANK} alt="" width={W} height={H} decoding="async" />
  </picture>
  <picture>
    <source media={`${WIDE} and (prefers-reduced-motion: reduce)`} type="image/svg+xml" srcset="/media/home/hero-launch-still.svg" />
    <source media={WIDE} type="image/svg+xml" srcset="/media/home/hero-launch.svg" />
    <img class="hero-launch-fx" src={BLANK} alt="" width={W} height={H} decoding="async" />
  </picture>
  <svg class="hero-launch-mark" viewBox={`0 0 ${W} ${H}`} focusable="false">
    <g class="hl-mark" transform={mark}>
      {LOGO.map((d) => <path d={d} />)}
    </g>
  </svg>
</div>
