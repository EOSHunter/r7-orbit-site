---
import MediaPlaceholder from './MediaPlaceholder.astro';
import type { Cover } from '../lib/cards';
import { SIZES, publicSrcset } from '../lib/media-srcset';

interface Props {
  cover?: Cover;
}

const { cover } = Astro.props;
const srcset = cover?.srcset ?? (await publicSrcset(cover?.src));
---

<div class="card-media">
  {cover ? (
    <img src={cover.src} srcset={srcset} sizes={srcset && SIZES.card} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" />
  ) : (
    <MediaPlaceholder />
  )}
  {cover?.motion && (
    // No <source> yet: nothing is fetched until the reader points at or focuses the card (card-motion.js adds them).
    <video class="card-motion" muted playsinline preload="none" disablepictureinpicture aria-hidden="true" tabindex="-1" width="800" height="450"
      data-mp4={cover.motion.mp4} data-webm={cover.motion.webm}></video>
  )}
  <slot />
</div>

<script>
  import '../scripts/card-motion.js';
</script>
