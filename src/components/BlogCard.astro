---
import CardFoot from './CardFoot.astro';
import CardMedia from './CardMedia.astro';
import Icon from './Icon.astro';
import { cardAttrs } from './cardAttrs';
import type { BlogCardData } from '../lib/cards';
import { plainTitle } from '../lib/text';

interface Props {
  post: BlogCardData;
}

const { post } = Astro.props;
const tags = post.tags ?? [];
---

<a {...cardAttrs(post)}>
  {(post.cover || post.pinned) && <CardMedia cover={post.cover} />}
  <div class="card-body">
    <span class="kind">
      <Icon name="blog" />
      Blog
    </span>
    <h3 class="card-title serif">{plainTitle(post.title)}</h3>
    <p class="card-text">{post.summary}</p>
    {tags.length > 0 && (
      <div class="cluster">
        {tags.slice(0, 3).map((tag) => (
          <span class="chip">{tag}</span>
        ))}
      </div>
    )}
    <CardFoot date={post.date} minutes={post.readTime} />
  </div>
</a>
