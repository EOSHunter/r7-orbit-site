---
import Icon from './Icon.astro';
import { footerItems, type FooterLink } from '../data/nav';
import { site } from '../data/site';

interface Props {
  /** The links to draw. Default: the ones in the site settings. Only the styleguide fixture passes others. */
  links?: FooterLink[];
}

// The nav items marked "show in footer", then the footer links (site.json, Site settings in /admin). A link to a profile that
// is empty in the settings is already left out (footerLinks in src/lib/site-settings.ts).
const { links = footerItems } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href="/">
          <img src="/assets/r7-mark.svg" alt="" width="21" height="18" />
          {site.name}
        </a>
        <p>{site.description}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                <Icon name={link.icon} />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="footer-legal">
        <span>&copy; {year}</span>
        {site.footer.note && <span>{site.footer.note}</span>}
      </p>
    </div>
  </div>
</footer>
