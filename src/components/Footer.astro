---
import Icon from './Icon.astro';
import { site } from '../data/site';

// Only links the owner has filled in appear (empty strings in site.json are left out).
const links = [
  { label: 'RSS', href: site.links.rss, icon: 'rss', external: false },
  { label: 'GitHub', href: site.links.github, icon: 'github', external: true },
  { label: 'YouTube', href: site.links.youtube, icon: 'vlog', external: true },
  { label: 'Subscribe', href: '/subscribe/', icon: 'mail', external: false },
] as const;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href="/">
          <img src="/assets/r7-mark.svg" alt="" width="21" height="18" />
          {site.name}
        </a>
        <p>{site.description}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {links
            .filter((link) => link.href)
            .map((link) => (
              <li>
                <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                  <Icon name={link.icon} />
                  {link.label}
                </a>
              </li>
            ))}
        </ul>
      </nav>
      <p class="footer-legal">
        <span>&copy; {year}</span>
        <span>Made with R7 Orbit</span>
      </p>
    </div>
  </div>
</footer>
