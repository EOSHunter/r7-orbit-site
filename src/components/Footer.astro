---
// The site's footer: the mark, the footer line and (while the newsletter is on) a small sign-up form; three columns of links (Read:
// the archives; Site: the other pages; Follow: the newsletter and the links elsewhere); and a last row with the year and the
// author's name, Privacy and the footer note. docs/DECISIONS.md, "Footer, 2026-11-10".
import Icon from './Icon.astro';
import NewsletterForm from './NewsletterForm.astro';
import { footerItems, navItems, type FooterLink, type NavItem } from '../data/nav';
import { site } from '../data/site';
import { footerColumns } from '../lib/site-settings';

interface Props {
  /** The links to draw. Default: the ones in the site settings. Only the styleguide fixture passes others. */
  links?: FooterLink[];
  /** The nav the Read and Site columns come from. Default: the site settings'. Only the styleguide fixture passes another. */
  nav?: NavItem[];
}

// Follow: Newsletter while it is on, the nav items marked "show in footer", then the footer links (site.json, Site settings in
// /admin). A link to a profile that is empty in the settings is already left out (footerLinks in src/lib/site-settings.ts).
const { links = footerItems, nav = navItems } = Astro.props;
const year = new Date().getFullYear();
// Read and Site come from the header's nav, so renaming a nav link renames it here too (footerColumns).
const columns = footerColumns(nav);
---

<footer class="site-footer">
  <div class="container wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href="/">
          <img src="/assets/r7-mark.svg" alt="" width="32" height="28" />
          {site.name}
        </a>
        <p>{site.footer.text || site.description}</p>
        <NewsletterForm id="footer-newsletter" variant="footer" />
      </div>
      <nav aria-label="Read">
        <p class="eyebrow" aria-hidden="true">
          Read
        </p>
        <ul class="footer-pages">
          {columns.read.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Site">
        <p class="eyebrow" aria-hidden="true">
          Site
        </p>
        <ul class="footer-pages">
          {columns.site.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Footer">
        <p class="eyebrow" aria-hidden="true">
          Follow
        </p>
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                <Icon name={link.icon} />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="footer-legal">
        <span>&copy; {year} {site.author.name}</span>
        <a href="/privacy/">Privacy</a>
        {site.footer.note && <span>{site.footer.note}</span>}
      </p>
    </div>
  </div>
</footer>
