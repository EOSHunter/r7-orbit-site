---
// The hub with no app published: the words are the page's (src/content/pages/apps.md), the button goes to the projects.
interface Props {
  heading: string;
  text: string;
  linkLabel: string;
}

const { heading, text, linkLabel } = Astro.props;
---

<div class="empty" data-apps-empty>
  <h2>{heading}</h2>
  <p>{text}</p>
  <a class="btn" href="/projects/">
    {linkLabel}
  </a>
</div>
