---
// What the hub shows under its heading: the grid of games, or the empty state when there are none. The page and its test fixture
// both use it, so the fixture exercises the real branches. The words come from the hub's entry (src/content/pages/games.md).
import GameGrid from './GameGrid.astro';
import GamesEmpty from './GamesEmpty.astro';
import type { GameCardData } from '../lib/cards';
import type { GamesCopy } from '../lib/site-pages-queries';

interface Props {
  games: GameCardData[];
  copy: GamesCopy;
}

const { games, copy } = Astro.props;
---

{
  games.length > 0 ? (
    <GameGrid {games} soon={{ eyebrow: copy.soonEyebrow, title: copy.soonTitle, text: copy.soonText }} eager />
  ) : (
    <GamesEmpty heading={copy.emptyHeading} text={copy.emptyText} linkLabel={copy.emptyLinkLabel} />
  )
}
