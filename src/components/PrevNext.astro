---
// The older and newer post of the same kind, each with the square of its card's picture, its title and its date.
import Icon from './Icon.astro';
import PostThumb from './PostThumb.astro';
import type { SitePost } from '../lib/content-queries';
import { toCard } from '../lib/post-cards';
import { isoDate, longDate, plainTitle } from '../lib/text';

interface Props {
  newer?: SitePost;
  older?: SitePost;
}

const { newer, older } = Astro.props;
const olderCard = older ? await toCard(older) : undefined;
const newerCard = newer ? await toCard(newer) : undefined;
---

{(olderCard || newerCard) && (
  <nav class="post-nav" aria-label="Previous and next post">
    {olderCard ? (
      <a class="prev" href={olderCard.href} rel="prev">
        <PostThumb card={olderCard} />
        <span class="post-nav-text">
          <span class="label-row"><Icon name="arrow" class="flip" />Older</span>
          <span class="title">{plainTitle(olderCard.title)}</span>
          <time class="post-nav-date" datetime={isoDate(olderCard.date)}>{longDate(olderCard.date)}</time>
        </span>
      </a>
    ) : <span />}
    {newerCard && (
      <a class="next" href={newerCard.href} rel="next">
        <PostThumb card={newerCard} />
        <span class="post-nav-text">
          <span class="label-row">Newer<Icon name="arrow" /></span>
          <span class="title">{plainTitle(newerCard.title)}</span>
          <time class="post-nav-date" datetime={isoDate(newerCard.date)}>{longDate(newerCard.date)}</time>
        </span>
      </a>
    )}
  </nav>
)}
