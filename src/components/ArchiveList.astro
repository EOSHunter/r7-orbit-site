---
// The toolbar, card grid, empty state and pagination of an archive. With JavaScript off it is the current page of cards and real
// pagination links. With it on, the toolbar appears; the first filter loads the cards of the other pages from the two <template>s
// (nothing is fetched), and tag / search / sort / kind / author state is kept in the URL query.
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';
import type { CardData, Kind } from '../lib/cards';
import { KIND_LABEL } from '../lib/cards';
import { countLabel, pageUrl } from '../lib/listing';

interface Props {
  /** Every card in this listing, newest first. */
  cards: CardData[];
  /** The cards of the current page (a slice of `cards`) and where that slice starts. */
  start: number;
  size: number;
  page: number;
  pages: number;
  /** The first page's path, ending in a slash. */
  base: string;
  /** Tags used by these cards, most used first. */
  tags: string[];
  /** Offer a kind filter (the mixed /latest/ archive). */
  kinds?: Kind[];
  /** Offer a "By author" filter: the authors who have posts here (shown when there are two or more, like the kinds). */
  authors?: { slug: string; name: string }[];
  noun: string;
  nounOne: string;
  /** Said when there is nothing at all in this listing: the heading, and the sentence under it. The archives pass their page
   *  entry's words (src/content/pages/); the author pages keep the sentence below, except an agent's, which passes '' (no sentence). */
  empty: string;
  emptyText?: string;
  /** Label for the search field and the results heading, e.g. "posts". */
  what: string;
}

const {
  cards,
  start,
  size,
  page,
  pages,
  base,
  tags,
  kinds = [],
  authors = [],
  noun,
  nounOne,
  empty,
  emptyText = 'Check back soon.',
  what,
} = Astro.props;
const shown = cards.slice(start, start + size);
const before = cards.slice(0, start);
const after = cards.slice(start + size);
const total = cards.length;
// A short list needs no search box, sort or row of tag chips: the whole list fits on a screen, so they would be machinery for
// a handful of cards. They appear from this many; the kind and author switches, and the count, show at any length.
const FULL_TOOLBAR = 12;
const full = total >= FULL_TOOLBAR;
// The Filters panel holds the sort, the authors and the tags; it exists when one of them does.
const panel = full || authors.length > 1;
---

{total === 0 ? (
  <div class="empty">
    <h2>{empty}</h2>
    {emptyText && <p>{emptyText}</p>}
  </div>
) : (
  <div
    data-archive
    data-total={total}
    data-noun={noun}
    data-noun-one={nounOne}
    data-base={pageUrl(base, 1)}
  >
    <div class="toolbar" role="group" aria-label={`Filter and sort ${what}`}>
      {(full || panel) && (
        <div class="toolbar-row toolbar-top">
          {full && (
            <form class="search" role="search" aria-label={`Search ${what}`}>
              <Icon name="search" />
              <label class="visually-hidden" for="archive-search">Search {what}</label>
              <input
                class="input"
                id="archive-search"
                type="search"
                name="q"
                placeholder={`Search ${what}`}
                autocomplete="off"
                data-search
              />
            </form>
          )}
          {panel && (
            <button class="btn filter-toggle" type="button" aria-expanded="false" aria-controls="archive-filters" data-filters-toggle>
              <Icon name="filter" />
              Filters
              <span class="filter-badge" data-filters-badge hidden></span>
            </button>
          )}
        </div>
      )}
      {kinds.length > 1 && (
        <div class="toolbar-row toolbar-kinds">
          <span class="eyebrow" id="kinds-label">Kind</span>
          <div class="seg" role="group" aria-labelledby="kinds-label" data-filter="kind">
            <button class="on" type="button" data-value="all" aria-pressed="true">All</button>
            {kinds.map((k) => (
              <button type="button" data-value={k} aria-pressed="false">
                {KIND_LABEL[k]}
              </button>
            ))}
          </div>
        </div>
      )}
      <p class="t-meta toolbar-count" data-count aria-live="polite">{countLabel(total, nounOne, noun)}</p>
      {panel && (
        // Sort, author and tags: out of the way until asked for (a phone would otherwise open on a screen of switches). What is
        // picked here shows as removable chips under the toolbar while the panel is closed.
        <div class="filter-panel" id="archive-filters" data-filters-panel hidden>
          {full && (
            <div class="filter-group">
              <span class="eyebrow" id="sort-label">Sort</span>
              <div class="seg" role="group" aria-labelledby="sort-label" data-sort>
                <button class="on" type="button" data-value="newest" aria-pressed="true">Newest</button>
                <button type="button" data-value="oldest" aria-pressed="false">Oldest</button>
              </div>
            </div>
          )}
          {authors.length > 1 && (
            <div class="filter-group">
              <span class="eyebrow" id="authors-label">By author</span>
              <div class="tag-list" role="group" aria-labelledby="authors-label" data-filter="author">
                <button class="chip on" type="button" data-value="all" aria-pressed="true">All</button>
                {authors.map((a) => (
                  <button class="chip" type="button" data-value={a.slug} aria-pressed="false">
                    {a.name}
                  </button>
                ))}
              </div>
            </div>
          )}
          {full && tags.length > 0 && (
            <div class="filter-group">
              <span class="eyebrow" id="tags-label">Tags</span>
              <div class="tag-list" role="group" aria-labelledby="tags-label" data-tags-filter>
                {tags.map((tag) => (
                  <button type="button" class="chip" data-tag={tag} aria-pressed="false">
                    {tag}
                  </button>
                ))}
              </div>
            </div>
          )}
          <div class="filter-panel-foot">
            <button class="btn quiet sm" type="button" data-clear>Clear all</button>
            <button class="btn sm" type="button" data-filters-done>Done</button>
          </div>
        </div>
      )}
      <div class="filter-active" data-filters-active hidden></div>
    </div>

    <h2 class="visually-hidden">{what[0]?.toUpperCase()}{what.slice(1)}</h2>
    <div class="grid-cards" data-items>
      {shown.map((post) => <PostCard post={{ ...post, filterable: true }} />)}
    </div>
    <template data-before>
      {before.map((post) => <PostCard post={{ ...post, filterable: true }} />)}
    </template>
    <template data-after>
      {after.map((post) => <PostCard post={{ ...post, filterable: true }} />)}
    </template>

    <div class="empty" data-empty hidden>
      <h2>Nothing matches that.</h2>
      <p>Try fewer words, or clear the filters.</p>
      <button class="btn" type="button" data-clear>Clear filters</button>
    </div>

    <Pagination {base} {page} {pages} />
  </div>
)}

<script>
  type Sort = 'newest' | 'oldest';
  interface Meta {
    index: number;
    kind: string;
    author: string;
    tags: string[];
    hay: string;
  }

  const root = document.querySelector<HTMLElement>('[data-archive]');
  const grid = root?.querySelector<HTMLElement>('[data-items]');

  if (root && grid) {
    const noun = root.dataset.noun ?? 'posts';
    const nounOne = root.dataset.nounOne ?? 'post';
    const total = Number(root.dataset.total) || 0;
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const sortBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-sort] button')];
    const kindBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-filter="kind"] button')];
    const authorBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-filter="author"] button')];
    const tagBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tags-filter] button')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const hideWhenFiltered = [...root.querySelectorAll<HTMLElement>('[data-hide-filtered]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-filters-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-filters-panel]');
    const badge = root.querySelector<HTMLElement>('[data-filters-badge]');
    const active = root.querySelector<HTMLElement>('[data-filters-active]');
    const done = root.querySelector<HTMLButtonElement>('[data-filters-done]');
    const authorName = new Map(authorBtns.map((b) => [b.dataset.value ?? '', b.textContent?.trim() ?? '']));

    const meta = new WeakMap<HTMLElement, Meta>();
    const onThisPage = new Set<HTMLElement>();
    let items: HTMLElement[] = [];
    let expanded = false;
    let orderedBy: Sort = 'newest';
    const state = { q: '', tags: [] as string[], sort: 'newest' as Sort, kind: 'all', author: 'all' };

    function index(): void {
      items = [...grid!.querySelectorAll<HTMLElement>('[data-item]')];
      items.forEach((el, i) => {
        const tags = (el.dataset.tags ?? '').toLowerCase().split(/\s+/).filter(Boolean);
        meta.set(el, {
          index: i,
          kind: el.dataset.kind ?? '',
          author: el.dataset.author ?? '',
          tags,
          hay: `${el.dataset.title ?? ''} ${el.dataset.text ?? ''} ${tags.join(' ')}`.toLowerCase(),
        });
      });
    }
    grid.querySelectorAll<HTMLElement>('[data-item]').forEach((el) => onThisPage.add(el));
    index();

    // The cards of the other pages are inert in <template>s until a filter needs them.
    function expand(): void {
      if (expanded) return;
      const before = root!.querySelector<HTMLTemplateElement>('template[data-before]');
      const after = root!.querySelector<HTMLTemplateElement>('template[data-after]');
      if (before) grid!.prepend(before.content.cloneNode(true));
      if (after) grid!.append(after.content.cloneNode(true));
      expanded = true;
      index();
    }

    function press(buttons: HTMLButtonElement[], isOn: (b: HTMLButtonElement) => boolean): void {
      for (const b of buttons) {
        const on = isOn(b);
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
    }

    function writeUrl(): void {
      const params = new URLSearchParams();
      if (state.q.trim()) params.set('q', state.q.trim());
      if (state.tags.length) params.set('tag', state.tags.join(','));
      if (state.sort !== 'newest') params.set('sort', state.sort);
      if (state.kind !== 'all') params.set('kind', state.kind);
      if (state.author !== 'all') params.set('author', state.author);
      const query = params.toString();
      try {
        history.replaceState(null, '', location.pathname + (query ? `?${query}` : '') + location.hash);
      } catch {
        /* a sandboxed frame: the filters still work, they just are not shareable */
      }
    }

    function render(): void {
      const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      const filtered = words.length > 0 || state.tags.length > 0 || state.sort !== 'newest' || state.kind !== 'all' || state.author !== 'all';
      if (filtered) expand();

      if (orderedBy !== state.sort) {
        const dir = state.sort === 'oldest' ? -1 : 1;
        [...items]
          .sort((a, b) => dir * ((meta.get(a)?.index ?? 0) - (meta.get(b)?.index ?? 0)))
          .forEach((el) => grid!.appendChild(el));
        orderedBy = state.sort;
      }

      let shown = 0;
      for (const el of items) {
        const m = meta.get(el);
        const match =
          !!m &&
          (state.kind === 'all' || m.kind === state.kind) &&
          (state.author === 'all' || m.author === state.author) &&
          state.tags.every((t) => m.tags.includes(t)) &&
          words.every((w) => m.hay.includes(w));
        const visible = filtered ? match : onThisPage.has(el);
        el.hidden = !visible;
        if (visible) shown++;
      }

      if (count) {
        count.textContent =
          filtered && shown !== total
            ? `${shown} of ${total} ${noun}`
            : `${total} ${total === 1 ? nounOne : noun}`;
      }
      if (empty) empty.hidden = shown !== 0;
      if (done) done.textContent = `Show ${shown} ${shown === 1 ? nounOne : noun}`;
      renderPicked();
      for (const el of hideWhenFiltered) el.hidden = filtered;

      press(sortBtns, (b) => (b.dataset.value ?? 'newest') === state.sort);
      press(kindBtns, (b) => (b.dataset.value ?? 'all') === state.kind);
      press(authorBtns, (b) => (b.dataset.value ?? 'all') === state.author);
      press(tagBtns, (b) => state.tags.includes((b.dataset.tag ?? '').toLowerCase()));
      writeUrl();
    }

    // What is picked inside the Filters panel (sort, author, tags), as chips that remove it: seen without opening the panel.
    function picked(): { key: string; label: string }[] {
      const out: { key: string; label: string }[] = [];
      if (state.sort !== 'newest') out.push({ key: 'sort', label: 'Oldest first' });
      if (state.author !== 'all') out.push({ key: 'author', label: authorName.get(state.author) ?? state.author });
      for (const t of state.tags) out.push({ key: `tag:${t}`, label: t });
      return out;
    }

    function renderPicked(): void {
      const list = picked();
      if (badge) {
        badge.hidden = list.length === 0;
        badge.textContent = String(list.length);
      }
      toggle?.setAttribute('aria-label', list.length ? `Filters, ${list.length} on` : 'Filters');
      if (!active) return;
      active.hidden = list.length === 0 || !panel?.hidden;
      active.replaceChildren(
        ...list.map(({ key, label }) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip on';
          b.dataset.remove = key;
          b.setAttribute('aria-label', `Remove filter: ${label}`);
          b.append(label);
          b.insertAdjacentHTML('beforeend', '<svg class="ico sm" aria-hidden="true"><use href="#i-close"></use></svg>');
          return b;
        }),
      );
    }

    function setPanel(open: boolean, focus = false): void {
      if (!panel || !toggle) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('on', open);
      renderPicked();
      if (open && focus) panel.querySelector<HTMLElement>('button')?.focus();
      if (!open && focus) toggle.focus();
    }

    toggle?.addEventListener('click', () => setPanel(panel?.hidden === true));
    done?.addEventListener('click', () => setPanel(false, true));
    panel?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPanel(false, true);
    });
    active?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-remove]');
      const key = b?.dataset.remove;
      if (!key) return;
      if (key === 'sort') state.sort = 'newest';
      else if (key === 'author') state.author = 'all';
      else if (key.startsWith('tag:')) state.tags = state.tags.filter((t) => t !== key.slice(4));
      render();
      (active.querySelector<HTMLElement>('button') ?? toggle)?.focus();
    });

    search?.addEventListener('input', () => {
      state.q = search.value;
      render();
    });
    search?.closest('form')?.addEventListener('submit', (e) => e.preventDefault());

    root.querySelector('[data-sort]')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      if (!b) return;
      state.sort = b.dataset.value === 'oldest' ? 'oldest' : 'newest';
      render();
    });
    root.querySelector('[data-filter="kind"]')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      if (!b) return;
      state.kind = b.dataset.value ?? 'all';
      render();
    });
    root.querySelector('[data-filter="author"]')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      if (!b) return;
      state.author = b.dataset.value ?? 'all';
      render();
    });
    root.querySelector('[data-tags-filter]')?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      const tag = b?.dataset.tag?.toLowerCase();
      if (!tag) return;
      state.tags = state.tags.includes(tag) ? state.tags.filter((t) => t !== tag) : [...state.tags, tag];
      render();
    });
    root.querySelectorAll('[data-clear]').forEach((b) =>
      b.addEventListener('click', () => {
        state.q = '';
        state.tags = [];
        state.sort = 'newest';
        state.kind = 'all';
        state.author = 'all';
        if (search) search.value = '';
        render();
        search?.focus();
      }),
    );

    // Start from the address: ?tag=evals,git&q=worktree&sort=oldest&kind=blog&author=r7
    const params = new URLSearchParams(location.search);
    state.q = params.get('q') ?? '';
    if (search) search.value = state.q;
    const known = new Set(tagBtns.map((b) => (b.dataset.tag ?? '').toLowerCase()));
    state.tags = (params.get('tag') ?? '')
      .toLowerCase()
      .split(',')
      .filter((t) => known.has(t));
    state.sort = params.get('sort') === 'oldest' ? 'oldest' : 'newest';
    const kind = params.get('kind') ?? 'all';
    state.kind = kindBtns.some((b) => b.dataset.value === kind) ? kind : 'all';
    const author = params.get('author') ?? 'all';
    state.author = authorBtns.some((b) => b.dataset.value === author) ? author : 'all';
    if (location.hash === '#search') search?.focus();
    render();
  }
</script>
