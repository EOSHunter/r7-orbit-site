---
// Up to three cards by shared tags, then recency (relatedPosts in lib/content, which skips drafts and scheduled posts). Renders nothing when there are none.
import PostCard from './PostCard.astro';
import { toCard } from '../lib/post-cards';
import type { SitePost } from '../lib/content-queries';
import type { CardData } from '../lib/cards';

interface Props {
  posts: SitePost[];
}

const { posts } = Astro.props;

// The same card data as every listing (src/lib/post-cards.ts), so a related card shows what the archive's card shows: a news
// item's own picture, a blog post's featured image. Reading time is left off: related cards are a pointer, not a preview.
const cards = (await Promise.all(posts.map((p) => toCard(p)))).map((card) => ({ ...card, readTime: undefined }) as CardData);
---

{cards.length > 0 && (
  <section class="section ruled related" aria-labelledby="related-h">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Related</p>
          <h2 class="section-title" id="related-h">Keep reading</h2>
        </div>
      </div>
      <div class="grid-cards">
        {cards.map((card) => <PostCard post={card} />)}
      </div>
    </div>
  </section>
)}
