---
import Icon from './Icon.astro';
import { navItems, type NavItem } from '../data/nav';
import { site } from '../data/site';
import { isCurrent } from '../lib/site-settings';

interface Props {
  /** The address of the nav item for the section you are in (e.g. "/blog/"), never its label. Gets aria-current="page". */
  current?: string;
  /** The nav to draw. Default: the one in the site settings. Only the styleguide fixture passes another. */
  items?: NavItem[];
}

const { current, items = navItems } = Astro.props;
---

<header class="site-header">
  <div class="container wide bar">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <img src="/assets/r7-mark.svg" alt="" width="21" height="18" />
      {site.name}
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      {items.map((item) => (
        <a href={item.href} aria-current={isCurrent(item, current) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <!-- search: data-search-open lets src/scripts/search.js open the dialog; without JS the link goes to /search/ -->
      <a class="btn quiet icon" href="/search/" aria-label="Search" data-search-open>
        <Icon name="search" />
      </a>
      <button
        class="btn quiet icon menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" class="i-menu" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>
