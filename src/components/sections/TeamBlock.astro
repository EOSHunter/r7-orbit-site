---
// The Team block: one card per person or agent, in the order the page lists them. Avatar, name (a link to their page), the title
// the page gives them with an agent's subtitle, an "AI agent" label for an agent (not "AI-written": this is not a post), and the bio
// from the authors list, so the words exist once; a `blurb` typed in the block replaces the bio on this card only.
import AgentChip from '../AgentChip.astro';
import AuthorAvatar from '../AuthorAvatar.astro';
import { getAuthorMap } from '../../lib/authors-queries';
import { isAgent } from '../../lib/authors';
import { teamProblems } from '../../lib/sections/checks';
import { loadKnown } from '../../lib/sections/known';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'team'>;
  ctx: BlockContext;
}

const { block, ctx } = Astro.props;
const problems = teamProblems(block, await loadKnown());
if (problems.length) throw new Error(`${ctx.where}: ${problems.join(' ')}`);
const authors = await getAuthorMap();
const members = block.members.map((m) => ({ ...m, author: authors.get(m.author)! }));
---

<ul class="grid-cards team-grid" role="list" data-team>
  {
    members.map(({ author, title, blurb }) => (
      <li class="card team-card" data-team-member={author.slug}>
        <div class="card-body">
          <div class="team-card-head">
            <AuthorAvatar author={author} large lazy />
            <div class="team-card-id">
              <h3 class="card-title team-name">
                <a class="author-name" href={author.path}>{author.name}</a>
              </h3>
              <p class="team-role">
                <span>{title}</span>
                {author.subtitle && ' '}
                {author.subtitle && <span class="author-sub">{author.subtitle}</span>}
              </p>
              {isAgent(author) && (
                <p class="team-label">
                  <AgentChip label="agent" />
                </p>
              )}
            </div>
          </div>
          <p class="team-bio">{blurb?.trim() || author.bio}</p>
        </div>
      </li>
    ))
  }
</ul>
