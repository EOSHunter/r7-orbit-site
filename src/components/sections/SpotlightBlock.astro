---
// The Spotlight block (docs/SECTIONS.md, `spotlight`): one thing called out in a section of its own. Eyebrow, heading, a paragraph
// and up to five points beside a picture (above the words on a phone), then a button. With `waitlist` on and the waitlist on in
// Site settings, the waitlist form (the hero's one-row variant) sits under the words and the button becomes a quieter link beside
// it; with the waitlist off the block is the same section with its button, so it never shows an empty form.
import Icon from '../Icon.astro';
import WaitlistForm from '../WaitlistForm.astro';
import { SIZES, publicSrcset } from '../../lib/media-srcset';
import { titleParts } from '../../lib/text';
import { waitlist as state } from '../../lib/waitlist-queries';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'spotlight'>;
  ctx: BlockContext;
}

const { block, ctx } = Astro.props;
const id = `spotlight-${ctx.index + 1}`;
const size = block.image ? ctx.sizes.get(block.image) : undefined;
const srcset = block.image ? await publicSrcset(block.image) : undefined;
const withForm = block.waitlist && state.show;
const button = block.buttonLabel && block.buttonUrl ? { label: block.buttonLabel, url: block.buttonUrl } : undefined;
const external = button?.url.startsWith('https://');
---

<section class="section ruled spotlight" aria-labelledby={`${id}-h`} data-spotlight>
  <div class="container wide">
    <div class:list={['spotlight-grid', block.image && 'has-picture']}>
      <div class="spotlight-words">
        {block.eyebrow && <p class="eyebrow brass">{block.eyebrow}</p>}
        <h2 class="section-title" id={`${id}-h`}>{titleParts(block.heading).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h2>
        {ctx.html.text && <div class="spotlight-text" set:html={ctx.html.text} />}
        {
          block.points.length > 0 && (
            <ul class="spotlight-points" role="list">
              {block.points.map((point) => (
                <li>{point.text}</li>
              ))}
            </ul>
          )
        }
        {withForm && <WaitlistForm variant="hero" source={block.source} id={`${id}-waitlist`} />}
        {
          button && (
            <p class="spotlight-actions">
              <a class={withForm ? 'more-link' : 'btn solid lg'} href={button.url}>
                {button.label}
                {withForm && <Icon name="arrow" />}
                {external && <span class="visually-hidden"> (another site)</span>}
              </a>
            </p>
          )
        }
      </div>
      {
        block.image && (
          <figure class="spotlight-picture">
            <img
              src={block.image}
              srcset={srcset}
              sizes={srcset && SIZES.half}
              alt={block.decorative ? '' : block.alt}
              width={size?.width}
              height={size?.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </div>
</section>
