---
// The newsletter sign-up: the SubscribeBand (a full-width section) or just the NewsletterForm in the text. Ids are made from the
// block's place so two on a page never share one. Nothing is sent until the provider is set in src/data/site.json.
import NewsletterForm from '../NewsletterForm.astro';
import SubscribeBand from '../SubscribeBand.astro';
import { titleParts } from '../../lib/text';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'newsletter'>;
  ctx: BlockContext;
}

const { block, ctx } = Astro.props;
const id = `sec-newsletter-${ctx.index + 1}`;
---

{
  block.style === 'form' ? (
    <section class="sec-newsletter" aria-labelledby={`${id}-h`}>
      <h2 id={`${id}-h`}>{titleParts(block.heading || 'One email when something new is worth reading').map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h2>
      {block.text && <p>{block.text}</p>}
      <NewsletterForm id={id} />
    </section>
  ) : (
    <SubscribeBand id={id} heading={block.heading || undefined} text={block.text || undefined} />
  )
}
