---
// The newest published posts as cards (PostCard), by kind, tag and/or author. The list comes from getAllPosts, which already
// leaves out drafts and future-dated posts (in `astro dev` they show, labelled). A tag or author no post has stops the build.
// Two frames: in the page (a heading over the cards, in a wide row) or a section of its own with a rule above (SectionBand, the
// home page's Projects and Repos rows). "Last updated first" orders repos by their last push on GitHub (build-time data, cached).
import PostCard from '../PostCard.astro';
import SectionBand from './SectionBand.astro';
import { getAllPosts } from '../../lib/content-queries';
import { authorSlugOf } from '../../lib/authors';
import type { CardData } from '../../lib/cards';
import { toCards } from '../../lib/post-cards';
import { latestProblems } from '../../lib/sections/checks';
import { loadKnown } from '../../lib/sections/known';
import { titleParts } from '../../lib/text';
import Icon from '../Icon.astro';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'latest'>;
  ctx: BlockContext;
}

const { block, ctx } = Astro.props;
const problems = latestProblems(block, await loadKnown());
if (problems.length) throw new Error(`${ctx.where}: ${problems.join(' ')}`);

// The kind a card shows for each collection.
const KIND_OF = { news: 'news', blog: 'blog', vlogs: 'vlog', projects: 'project', repos: 'repo' } as const;
const posts = (await getAllPosts())
  .filter((post) => !block.kinds.length || (block.kinds as readonly string[]).includes(KIND_OF[post.collection]))
  .filter((post) => !block.tag || post.data.tags.includes(block.tag))
  .filter((post) => !block.author || authorSlugOf(post) === block.author);

// Newest first is the posts' own order. Last updated first needs the cards (a repo's last push is GitHub data), so all of them.
const when = (c: CardData) => String(c.kind === 'repo' ? (c.updated ?? c.date) : c.date);
const cards =
  block.order === 'updated'
    ? (await toCards(posts)).sort((a, b) => when(b).localeCompare(when(a))).slice(0, block.count)
    : await toCards(posts.slice(0, block.count));

const eyebrow = block.eyebrow || undefined;
const moreLabel = block.moreLabel || undefined;
const moreUrl = block.moreUrl || undefined;
const headed = eyebrow || (moreLabel && moreUrl);
---

{
  cards.length === 0 && block.ifEmpty === 'hide' ? null : block.look === 'section' ? (
    <SectionBand headingId={`sec-${ctx.index + 1}-h`} {eyebrow} heading={block.heading || undefined} {moreLabel} {moreUrl} ruled>
      {cards.length > 0 ? (
        <div class="grid-cards">
          {cards.map((post) => (
            <PostCard {post} />
          ))}
        </div>
      ) : (
        <p class="t-meta">Nothing has been posted here yet.</p>
      )}
    </SectionBand>
  ) : (
    <div class="latest-posts">
      {headed ? (
        <div class="section-head">
          <div>
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            {block.heading && <h2 class="section-title">{titleParts(block.heading).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h2>}
          </div>
          {moreLabel && moreUrl && (
            <a class="more-link" href={moreUrl}>
              {moreLabel}
              <Icon name="arrow" />
            </a>
          )}
        </div>
      ) : (
        block.heading && <h2 class="section-title">{titleParts(block.heading).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h2>
      )}
      {cards.length > 0 ? (
        <div class="grid-cards">
          {cards.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="t-meta">Nothing has been posted here yet.</p>
      )}
    </div>
  )
}
