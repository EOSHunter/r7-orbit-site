---
// A picture in a side column with the text beside it (above it on a phone). The blocks Sections.astro puts in this block's slot
// (the heading just above it goes in the `lead` slot) sit in the same text column.
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';
import { SIZES, publicSrcset } from '../../lib/media-srcset';

interface Props {
  block: SectionOf<'portrait'>;
  ctx: BlockContext;
  /** The portrait opens the page (Sections.astro: the first row), so it is likely the largest thing on screen: fetched first.
   *  A portrait further down loads lazily, like the other pictures, and does not compete with what is on screen. */
  first?: boolean;
}

const { block, ctx, first = false } = Astro.props;
const size = ctx.sizes.get(block.image);
const srcset = await publicSrcset(block.image);
---

<div class="about-grid" data-side={block.side}>
  <div class="portrait">
    <img
      src={block.image}
      srcset={srcset}
      sizes={srcset && SIZES.portrait}
      alt={block.decorative ? '' : block.alt}
      width={size?.width}
      height={size?.height}
      fetchpriority={first ? 'high' : undefined}
      loading={first ? undefined : 'lazy'}
    />
  </div>
  <div class="prose">
    <slot name="lead" />
    <Fragment set:html={ctx.html.text} />
    <slot />
  </div>
</div>
