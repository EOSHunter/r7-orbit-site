---
// A solid button that links to a page of this site or to another site.
import Icon from '../Icon.astro';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'button'>;
  ctx: BlockContext;
}

const { block } = Astro.props;
const external = block.url.startsWith('https://');
---

<p class="sec-button">
  <a class="btn solid" href={block.url} rel={external ? 'noopener' : undefined}>
    {block.label}
    {external && <Icon name="external" />}
  </a>
</p>
