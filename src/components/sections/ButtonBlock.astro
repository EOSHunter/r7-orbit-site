---
// A solid button that links to a page of this site or to another site, in the same tab or (newTab) a new one.
import Icon from '../Icon.astro';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'button'>;
  ctx: BlockContext;
}

const { block } = Astro.props;
const external = block.url.startsWith('https://');
---

<p class="sec-button">
  <a class="btn solid" href={block.url} target={block.newTab ? '_blank' : undefined} rel={external || block.newTab ? 'noopener' : undefined}>
    {block.label}
    {external && <Icon name="external" />}
  </a>
</p>
