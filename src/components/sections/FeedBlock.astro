---
// The Latest feed: the newest posts of every kind (the first marked New), a filter by kind once two kinds are among them (site.js,
// `[data-list]`), links to each kind's archive that has posts, and a link to everything. The anchor is #latest (the home page's
// "Start with the latest" button points at it), which is why a page holds one (`once` in its definition). The words the author
// edits are the block's; the filter's own messages ("Nothing matches that.") are the filter's, here. On a page with a Pinned post
// block, the pinned post is left out of the feed (pinnedPost), so the same card is not shown twice.
import Icon from '../Icon.astro';
import PostCard from '../PostCard.astro';
import { getAllPosts } from '../../lib/content-queries';
import type { Kind } from '../../lib/cards';
import { countLabel } from '../../lib/listing';
import { pinnedPost } from '../../lib/content';
import { toCards } from '../../lib/post-cards';
import { titleParts } from '../../lib/text';
import type { BlockContext } from './context';
import type { SectionOf } from '../../lib/sections';

interface Props {
  block: SectionOf<'feed'>;
  ctx: BlockContext;
}

const { block, ctx } = Astro.props;
const posts = await getAllPosts();
const pinned = pinnedPost(posts, ctx.hasPinned);

// `kinds`: only these kinds of post (none chosen = every kind); the home page leaves news to its News desk.
const KIND_OF_COLLECTION: Record<string, Kind> = { news: 'news', blog: 'blog', vlogs: 'vlog', projects: 'project', repos: 'repo' };
const shown = posts.filter((post) => post !== pinned && (!block.kinds.length || (block.kinds as readonly string[]).includes(KIND_OF_COLLECTION[post.collection])));
const latest = await toCards(shown.slice(0, block.count), { filterable: true });
if (latest[0]) latest[0] = { ...latest[0], fresh: true };

const kindOrder: Kind[] = ['news', 'blog', 'vlog', 'project', 'repo'];
const kinds = kindOrder.filter((kind) => latest.some((card) => card.kind === kind));
// Links to the archives of every kind that has something, not only the kinds among the latest posts.
const KIND_COLLECTION: Record<Kind, string> = { news: 'news', blog: 'blog', vlog: 'vlogs', project: 'projects', repo: 'repos' };
const browseKinds = block.browseLabel ? kindOrder.filter((kind) => posts.some((post) => post.collection === KIND_COLLECTION[kind])) : [];
const KIND_PLURAL: Record<Kind, string> = { news: 'News', blog: 'Blogs', vlog: 'Vlogs', project: 'Projects', repo: 'Repos' };
const KIND_HREF: Record<Kind, string> = {
  news: '/news/',
  blog: '/blog/',
  vlog: '/vlogs/',
  project: '/projects/',
  repo: '/repos/',
};
---

<section class="section ruled" id="latest" aria-labelledby="latest-h" data-list>
  <div class="container wide">
    <div class="feed-head">
      <h2 class="section-title" id="latest-h">{titleParts(block.heading).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h2>
      <span class="spacer"></span>
      {kinds.length > 1 && (
        <div class="seg" role="group" aria-label="Filter by kind" data-filter="kind">
          <button class="on" type="button" data-value="all" aria-pressed="true">All</button>
          {kinds.map((kind) => (
            <button type="button" data-value={kind} aria-pressed="false">
              {KIND_PLURAL[kind]}
            </button>
          ))}
        </div>
      )}
    </div>
    {latest.length > 0 ? (
      <>
        <p class="t-meta feed-count" data-count data-noun="posts" data-noun-one="post" aria-live="polite">{countLabel(latest.length, 'post', 'posts')}</p>
        <div class="grid-cards" data-items>
          {latest.map((post) => <PostCard {post} />)}
        </div>
        <div class="empty" data-empty hidden>
          <h3 class="t-h3">Nothing matches that.</h3>
          <p>None of the latest posts are of this kind. Try another kind, or see everything.</p>
          <button class="btn" type="button" data-clear>Show all posts</button>
        </div>
      </>
    ) : (
      <div class="empty">
        <h3 class="t-h3">{block.emptyHeading}</h3>
        {block.emptyText && <p>{block.emptyText}</p>}
      </div>
    )}
    {browseKinds.length > 0 && (
      <nav class="feed-kinds" aria-label={block.browseLabel}>
        <span class="eyebrow">{block.browseLabel}</span>
        <ul>
          {browseKinds.map((kind) => (
            <li>
              <a class="chip" href={KIND_HREF[kind]}>
                <Icon name={kind} />
                {KIND_PLURAL[kind]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {latest.length > 0 && block.moreLabel && block.moreUrl && (
      <p class="feed-more">
        <a class="more-link" href={block.moreUrl}>
          {block.moreLabel}
          <Icon name="arrow" />
        </a>
      </p>
    )}
  </div>
</section>
