---
// Two or three images side by side, each with an optional caption. One column below 600px.
// Exported twice: as ImageRow and as ImageGallery (the lightbox gallery for projects is a different component, Gallery.astro).
import MediaPlaceholder from '../MediaPlaceholder.astro';
import { resolveImage, type ImageSource } from '../../lib/article';
import '../../styles/markdown.css';
import '../../styles/article.css';

interface Item {
  /** Omit for the placeholder plate. */
  src?: ImageSource;
  alt: string;
  caption?: string;
}

interface Props {
  images: Item[];
  /** A caption for the whole row, under it. */
  caption?: string;
}

const { images, caption } = Astro.props;
if (images.length < 2 || images.length > 3) {
  throw new Error(`ImageRow: expects 2 or 3 images, got ${images.length}. Use Figure for one.`);
}
const items = images.map((item) => {
  if (item.alt === undefined) throw new Error('ImageRow: every image needs alt text (use "" only for decoration).');
  return { ...item, image: item.src === undefined ? undefined : resolveImage(item.src, 'ImageRow') };
});
---

<figure class="art-row" data-count={items.length}>
  <div class="art-row-grid">
    {
      items.map((item) => (
        <figure class="art-fig">
          {
            item.image ? (
              <img class="art-img" src={item.image.src} alt={item.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" />
            ) : (
              <div class="media" role={item.alt ? 'img' : undefined} aria-label={item.alt || undefined}><MediaPlaceholder /></div>
            )
          }
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
  {caption && <figcaption class="art-row-caption">{caption}</figcaption>}
</figure>
