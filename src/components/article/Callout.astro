---
// A boxed aside. `info` is a plain panel, `tip` is brass, `warn` uses the muted red of the "failed" status.
// Kinds are told apart by the label as well as the colour. Same classes as the `> [!NOTE]` Markdown syntax.
import '../../styles/markdown.css';
import '../../styles/article.css';

interface Props {
  type?: 'info' | 'warn' | 'tip';
  /** Replaces the default label (Note, Warning, Tip). */
  title?: string;
}

const LABELS = { info: 'Note', tip: 'Tip', warn: 'Warning' } as const;
const CLASSES = { info: 'callout', tip: 'callout brass', warn: 'callout bad' } as const;

const { type = 'info', title } = Astro.props;
if (!(type in LABELS)) throw new Error(`Callout: type must be info, warn or tip, got "${type}".`);
---

<div class={`${CLASSES[type]} art-callout`} role="note" data-type={type}>
  <p class="art-callout-title"><strong>{title ?? LABELS[type]}.</strong></p>
  <div class="art-callout-body"><slot /></div>
</div>
