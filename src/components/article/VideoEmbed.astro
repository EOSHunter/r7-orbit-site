---
// A YouTube video in the article. Wraps the site's click-to-load player (YouTubeFacade), so nothing is requested from
// YouTube until the reader presses play.
import YouTubeFacade from '../YouTubeFacade.astro';
import '../../styles/article.css';

interface Props {
  /** The 11-character YouTube id. */
  id: string;
  title: string;
  /** A local image. Omit it for the placeholder plate. */
  poster?: string;
  duration?: string;
  chapters?: { t: string; title: string }[];
  caption?: string;
}

const { id, title, poster, duration, chapters, caption } = Astro.props;
---

<figure class="art-video">
  <YouTubeFacade id={id} title={title} poster={poster} duration={duration} chapters={chapters} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
