---
// An image with a caption. Without `src` it shows the placeholder plate (CLAUDE.md: no stock or generated images).
// `alt` is required, and an empty one is refused unless `decorative` is set (the image adds nothing for someone who cannot see it).
// Local files only: /src/assets/... (optimised at build), /media/... (public/media/, served as it is) or an imported image.
import MediaPlaceholder from '../MediaPlaceholder.astro';
import ArticleImage from './ArticleImage.astro';
import { resolveBodyImage } from './assets';
import type { ImageSource } from '../../lib/article';
import '../../styles/markdown.css';
import '../../styles/article.css';

interface Props {
  /** A local path or an imported image. Omit it for the placeholder plate. */
  src?: ImageSource;
  alt: string;
  /** The picture is only decoration: no alt text is needed (and `alt` is ignored). */
  decorative?: boolean;
  caption?: string;
  /** `left` and `right` float beside the text from 720px up and stack below that. `full` fills the column edge to edge. */
  align?: 'left' | 'right' | 'center' | 'full';
  /** Width for left, right and center: small, medium or large (large fills the column). Ignored by `full`. */
  size?: 'sm' | 'md' | 'lg';
  width?: number;
  height?: number;
}

const { src, alt: altProp, decorative = false, caption, align = 'center', size = 'lg', width, height } = Astro.props;
if (altProp === undefined && !decorative) throw new Error('Figure: alt is required (or set decorative for a picture that is only decoration).');
if (src !== undefined && !decorative && !altProp?.trim()) {
  throw new Error('Figure: the image has no alt text. Describe it in one plain sentence, or set decorative if it is only decoration.');
}
const alt = decorative ? '' : (altProp ?? '');
const image = src === undefined ? undefined : await resolveBodyImage(src, 'Figure');

// How wide the picture is drawn (article.css), so the browser picks the right file from the srcset. On a phone the column is
// 92vw (.container's 4vw gutter a side), and the small sizes keep their max-width there (14rem, 20rem, 32rem): saying 100vw
// makes the browser take a copy a size or two too big.
const floated = align === 'left' || align === 'right';
const sizes =
  align === 'full' || size === 'lg'
    ? '(min-width: 760px) 720px, 92vw'
    : size === 'md'
      ? floated ? '320px' : '(min-width: 557px) 512px, 92vw'
      : floated ? '224px' : '320px';
---

<figure class="art-fig" data-align={align} data-size={size}>
  {
    image ? (
      <ArticleImage image={image} alt={alt} sizes={sizes} width={width} height={height} />
    ) : (
      <div class="media" role={alt ? 'img' : undefined} aria-label={alt || undefined}><MediaPlaceholder /></div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
