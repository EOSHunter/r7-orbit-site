---
// A break between parts of an article. `rule` is the hairline; `dots` is three brass dots for a pause in the story.
import '../../styles/article.css';

interface Props {
  variant?: 'rule' | 'dots';
}

const { variant = 'rule' } = Astro.props;
---

{
  variant === 'dots' ? (
    <div class="art-divider" role="separator" data-variant="dots"><span></span><span></span><span></span></div>
  ) : (
    <hr class="art-divider" data-variant="rule" />
  )
}
