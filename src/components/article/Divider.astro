---
// A break between parts of an article. `rule` is the hairline; `dots` is three brass dots for a pause in the story; `orbit` is the
// logo's small ring and dot between two fading hairlines, for the main breaks.
import '../../styles/article.css';
import { orbitDividerHtml } from '../../lib/article-brand';

interface Props {
  variant?: 'rule' | 'dots' | 'orbit';
}

const { variant = 'rule' } = Astro.props;
---

{
  variant === 'orbit' ? (
    <Fragment set:html={orbitDividerHtml()} />
  ) : variant === 'dots' ? (
    <div class="art-divider" role="separator" data-variant="dots"><span></span><span></span><span></span></div>
  ) : (
    <hr class="art-divider" data-variant="rule" />
  )
}
