---
interface Props {
  /** Unique per page: used for the label and input ids. */
  id?: string;
  heading?: string;
  text?: string;
}

const {
  id = 'subscribe',
  heading = 'One email when something new is worth reading',
  text = 'New posts and videos, a few times a month. No tracking, and you can leave in one click.',
} = Astro.props;
---

<section class="band" {id} aria-labelledby={`${id}-h`}>
  <div class="container wide">
    <div class="subscribe">
      <div>
        <p class="eyebrow">Newsletter</p>
        <h2 id={`${id}-h`} style="margin-top: var(--s-3)">
          {heading}
        </h2>
        <p>{text}</p>
      </div>
      <!-- Nothing is sent yet: src/scripts/site.js shows a sample message. Phase 5 wires the provider in site.json. -->
      <form data-newsletter novalidate>
        <div class="field">
          <label for={`${id}-email`}>Email address</label>
          <div class="subscribe-row">
            <input
              class="input"
              id={`${id}-email`}
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
            <button class="btn solid" type="submit">
              Subscribe
            </button>
          </div>
          <p class="hint" data-newsletter-msg role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
