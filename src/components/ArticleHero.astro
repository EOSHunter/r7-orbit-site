---
// The top of a blog post: breadcrumbs, then the headline block (both passed in the slot). With a featured image the
// slot sits on top of it, over a dark gradient; without one it renders exactly the plain header.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  /** Alt text for the image; "" marks it decorative. */
  alt?: string;
}

const { image, alt = '' } = Astro.props;
---

{
  image ? (
    <div class="article-hero">
      <Picture
        class="article-hero-img"
        src={image}
        alt={alt}
        widths={[480, 768, 1200, 1600, 2000]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
      <div class="article-hero-shade" aria-hidden="true" />
      <div class="container article-hero-body">
        <slot />
      </div>
    </div>
  ) : (
    <div class="container">
      <slot />
    </div>
  )
}

<style is:global>
  .article-hero { position: relative; isolation: isolate; margin-bottom: var(--s-7); background: var(--bg); overflow: hidden; }
  .article-hero-img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  /* A dark veil over any image. The base of the gradient is near-solid, so the byline (the lowest, smallest text)
     always sits on a dark ground. */
  .article-hero-shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to bottom, rgb(9 9 10 / 0.55) 0%, rgb(9 9 10 / 0.72) 45%, rgb(9 9 10 / 0.92) 100%);
  }
  /* Text over a photo: the supporting text and brass are lifted a step, so they keep 4.5:1 where the image is bright. */
  .article-hero-body {
    --text-2: #d3cdbf;
    --text-3: #bdb8ab;
    --line: rgb(236 228 210 / 0.16);
    --line-strong: rgb(236 228 210 / 0.3);
    --brass: #e3c98f;
    --brass-bright: #f1dca8;
    --brass-dim: #c9a96a;
    color: var(--text);
    padding-bottom: var(--s-4);
  }
  .article-hero-body .post-head { padding-top: var(--s-7); }
  .article-hero-body .post-head h1 { text-shadow: 0 1px 24px rgb(9 9 10 / 0.6); }
  .article-hero-body .avatar img { filter: none; }
  .article-hero-body a.chip.link { background: rgb(9 9 10 / 0.45); }
  @media (min-width: 900px) { .article-hero-body .post-head { padding-top: var(--s-8); } }
  @media (forced-colors: active) { .article-hero-shade { background: Canvas; opacity: 0.85; } }
  @media print { .article-hero-img, .article-hero-shade { display: none; } .article-hero-body { --text: CanvasText; --text-2: CanvasText; --text-3: CanvasText; } }
</style>
