---
// One app on the hub, the home row and the "More apps" strip: poster, its type, name, one line, platforms, the primary button
// (Play for a game, Open for an app) and a Details link. Not one big link like PostCard, because it carries two actions. The type
// is told by a chip with its icon and label (src/lib/app-types.ts), never by colour.
import Icon from './Icon.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import PreviewBadge from './PreviewBadge.astro';
import type { AppCardData } from '../lib/cards';
import { APP_TYPES } from '../lib/app-types';
import { PLATFORM_LABEL } from '../lib/play';
import { plainTitle } from '../lib/text';
import { SIZES, publicSrcset } from '../lib/media-srcset';

interface Props {
  app: AppCardData;
  /** Level of the title: 2 under the page's h1, 3 under a section heading. */
  level?: 2 | 3;
  /** Load the poster at once (the first row). Later cards are lazy-loaded. */
  eager?: boolean;
}

const { app, level = 2, eager = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const title = plainTitle(app.title);
const { play } = app;
const type = APP_TYPES[app.type];
const srcset = await publicSrcset(app.cover?.src);
---

<article class="card app-card">
  <div class="card-media">
    {app.cover ? (
      <img
        src={app.cover.src}
        srcset={srcset}
        sizes={srcset && SIZES.card}
        alt={app.cover.alt}
        width={app.cover.width}
        height={app.cover.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <MediaPlaceholder />
    )}
  </div>
  <div class="card-body">
    <div class="cluster">
      <span class="chip app-type" data-app-type={app.type}><Icon name={type.icon} small />{type.label}</span>
      {app.preview && <PreviewBadge label={app.preview} />}
    </div>
    <Heading class="card-title">{title}</Heading>
    <p class="card-text">{app.summary}</p>
    {app.platforms.length > 0 && (
      <ul class="app-platforms" aria-label="Works on">
        {app.platforms.map((p) => (
          <li class="chip mono">{PLATFORM_LABEL[p]}</li>
        ))}
      </ul>
    )}
    <div class="app-actions">
      <a
        class="btn solid"
        href={play.href}
        target={play.external ? '_blank' : undefined}
        rel={play.external ? 'noopener' : undefined}
      >
        <Icon name={type.icon} />
        {type.action}
        <span class="visually-hidden">
          {' '}
          {title}
          {play.external ? ' (opens in a new tab)' : ''}
        </span>
        {play.external && <Icon name="external" small />}
      </a>
      <a class="btn" href={app.href}>
        Details<span class="visually-hidden"> for {title}</span>
      </a>
    </div>
  </div>
</article>
