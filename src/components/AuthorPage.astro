---
// One author's page: /authors/<slug>/ and its /page/N/ routes. Avatar, name, subtitle (and "AI-written" for an agent), bio, then every
// published post by this author across all kinds, through the same ArchiveList (filters, paging, empty state) as the archives.
// A page with no posts is noindex and out of the sitemap (src/lib/sitemap.ts), like an empty archive; an agent with none (Parallax
// writes notes, not posts) is labelled "AI agent" instead of "AI-written" and its page says plainly that it has no posts.
// An agent credited for featured images (Pictor) shows those posts first, as cards (picture, hover clip, link), under
// "Images by <name>"; with images and no posts, the empty "no posts" box is left out.
import AgentChip from './AgentChip.astro';
import ArchiveList from './ArchiveList.astro';
import PostCard from './PostCard.astro';
import AuthorAvatar from './AuthorAvatar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { authorProfilePageLd, isAgent, noPostsText, type Author } from '../lib/authors';
import type { Kind } from '../lib/cards';
import { tagCounts } from '../lib/content';
import { PAGE_SIZE, pageUrl } from '../lib/listing';
import { toCards } from '../lib/post-cards';
import type { SitePost } from '../lib/content-queries';
import { breadcrumbLd, jsonLdString, profileUrls } from '../lib/seo';

interface Props {
  author: Author;
  /** Every published post by this author, newest first. */
  posts: SitePost[];
  /** Published blog posts whose featured image this agent made (page 1 only). */
  images?: SitePost[];
  page: number;
  pages: number;
  /** Kept out of search engines. Default: when the author has no published posts (the styleguide fixture also sets it). */
  noindex?: boolean;
}

const { author, posts, images = [], page, pages, noindex = posts.length === 0 } = Astro.props;
const base = Astro.site?.href ?? site.url;

const cards = await toCards(posts, { filterable: true });
const imageCards = await toCards(images);
const kinds: Kind[] = (['news', 'blog', 'vlog', 'project', 'repo'] as const).filter((k) => cards.some((c) => c.kind === k));
const tags = tagCounts(posts).map((t) => t.tag);
const ld = [
  authorProfilePageLd(author, base, profileUrls(site.links)),
  breadcrumbLd(site, [{ name: author.name, path: author.path }, ...(page > 1 ? [{ name: `Page ${page}` }] : [])]),
];
---

<BaseLayout
  title={page > 1 ? `${author.name}, page ${page}` : author.name}
  description={page > 1 ? `Page ${page} of ${pages}. ${author.bio}` : author.bio}
  {noindex}
>
  <script slot="head" type="application/ld+json" set:html={jsonLdString(ld)} />
  {page > 1 && <link slot="head" rel="prev" href={pageUrl(author.path, page - 1)} />}
  {page < pages && <link slot="head" rel="next" href={pageUrl(author.path, page + 1)} />}

  <div class="container wide">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {page > 1 ? <li><a href={author.path}>{author.name}</a></li> : <li aria-current="page">{author.name}</li>}
        {page > 1 && <li aria-current="page">Page {page}</li>}
      </ol>
    </nav>

    <header class="page-head author-head" data-author-page={author.slug} data-author-kind={author.kind}>
      <AuthorAvatar author={author} large />
      <div class="author-head-body">
        <h1>{author.name}</h1>
        {(author.subtitle || isAgent(author)) && (
          <p class="author-meta">
            {author.subtitle && <span class="author-sub">{author.subtitle}</span>}
            {isAgent(author) && <AgentChip label={posts.length ? 'written' : 'agent'} />}
          </p>
        )}
        <p class="t-lead">{author.bio}</p>
      </div>
    </header>

    {imageCards.length > 0 && (
      <section class="author-images" aria-labelledby="author-images-h">
        <h2 class="section-title" id="author-images-h">Images by {author.name}</h2>
        <p class="t-meta">{imageCards.length} {imageCards.length === 1 ? 'image' : 'images'}, each made for the post it opens.</p>
        <div class="grid-cards">
          {imageCards.map((card) => <PostCard post={card} />)}
        </div>
      </section>
    )}

    {(posts.length > 0 || imageCards.length === 0) && <ArchiveList
      cards={cards}
      start={(page - 1) * PAGE_SIZE}
      size={PAGE_SIZE}
      {page}
      {pages}
      base={author.path}
      {tags}
      {kinds}
      noun="posts"
      nounOne="post"
      empty={noPostsText(author)}
      emptyText={isAgent(author) ? '' : undefined}
      what="posts"
    />}
  </div>
  <div class="archive-end"></div>
</BaseLayout>
