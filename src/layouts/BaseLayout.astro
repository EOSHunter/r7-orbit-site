---
import Footer from '../components/Footer.astro';
import { newsletterSettings } from '../lib/newsletter-queries';
import Header from '../components/Header.astro';
import IconSprite from '../components/IconSprite.astro';
import Search from '../components/Search.astro';
import type { NavItem } from '../data/nav';
import { site } from '../data/site';
import { resolveSeo } from '../lib/seo';
import { footerLinks } from '../lib/site-settings';
import { checkSiteLinks } from '../lib/site-routes';
import { isoDate, plainTitle } from '../lib/text';
import '../styles/design-system/tokens.css';
import '../styles/design-system/components.css';
import '../styles/site.css';

interface Props {
  /** Page title without the site name. May carry *italic* markers; they are stripped here. Ignored on the home page. */
  title: string;
  /** Meta description, 155 characters or fewer. */
  description?: string;
  /** Home page: the title becomes "{site name} · {tagline}". */
  home?: boolean;
  /** og:type. `website` for home and archives, `article` for news and blog, `video.other` for vlogs. */
  ogType?: 'website' | 'article' | 'video.other';
  /** Path or absolute URL of a 1200x630 image. Defaults to the brand image. */
  image?: string;
  imageAlt?: string;
  published?: Date | string;
  modified?: Date | string;
  tags?: string[];
  /** Keeps the page out of search engines (the styleguide, search, thin tag pages). */
  noindex?: boolean;
  /** The address of the nav item for the section this page belongs to (e.g. "/blog/"), never its label. */
  current?: string;
  /** Another nav than the site settings' one. Only the styleguide fixture uses it (tests/site-settings.spec.js). */
  nav?: NavItem[];
}

const {
  title,
  description,
  home = false,
  ogType = 'website',
  image,
  imageAlt,
  published,
  modified,
  tags = [],
  noindex = false,
  current,
  nav,
} = Astro.props;

// Every link in the site settings goes to a page or file that exists (once per build; src/lib/site-routes.ts).
checkSiteLinks(site);

const pageTitle = home ? `${site.name} · ${site.tagline}` : `${plainTitle(title)} · ${site.name}`;
const base = Astro.site ?? new URL(site.url);
// Canonical and Open Graph fallbacks (brand image, description, alt text) live in src/lib/seo.ts.
const seo = resolveSeo({
  path: Astro.url.pathname,
  base: base.href,
  description,
  fallbackDescription: site.description,
  image,
  imageAlt,
  fallbackImage: site.defaultOgImage,
  fallbackImageAlt: site.defaultOgImageAlt,
});
const { canonical, imageUrl } = seo;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#09090a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={home ? pageTitle : plainTitle(title)} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {seo.imageAlt && <meta property="og:image:alt" content={seo.imageAlt} />}
    {published && <meta property="article:published_time" content={isoDate(published)} />}
    {modified && <meta property="article:modified_time" content={isoDate(modified)} />}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="preload" href="/fonts/inter-core-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-core-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-core-400-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <IconSprite />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header current={current} items={nav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer links={nav && footerLinks({ ...site, newsletter: newsletterSettings, nav })} nav={nav} />
    <!-- search: the dialog opened by "/" and the header button -->
    <Search />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
