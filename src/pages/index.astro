---
// The home page. Its words and the order of its rows are src/content/pages/home.md (edited in /admin, "Pages" > Home page): the
// hero is the entry's own fields (the headline is the page's h1), and every row below it is a block (the shared library,
// docs/SECTIONS.md): Pinned post, Latest feed, Latest posts (Projects, Repos), Apps row. The blocks query the posts when the site
// is built.
import Sections from '../components/Sections.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { loadSitePage } from '../lib/site-pages-queries';
import { jsonLdString, websiteLd } from '../lib/seo';
import { titleParts } from '../lib/text';
import { waitlist } from '../lib/waitlist-queries';

const home = await loadSitePage('home');
const { title, description, sections, buttons = [] } = home.data;
// The waitlist form under the buttons: asked for by the page (`waitlist: true`) and shown only while the waitlist is on.
const heroWaitlist = home.data.waitlist === true && waitlist.show;
// The moving background behind the hero (scripts/hero-fx.ts), when the page asks for one.
const background = home.data.background === 'galaxy' ? 'galaxy' : undefined;
const eyebrow = home.text('eyebrow');
const lead = home.text('lead');
---

<BaseLayout title={title} {description} home current="/#latest">
  <script slot="head" type="application/ld+json" set:html={jsonLdString(websiteLd(site))} />
  <section class="hero plate-grid" aria-labelledby="hero-h">
    {background && <div class="hero-fx" data-hero-fx={background} aria-hidden="true" />}
    <div class="container wide">
      <div class="hero-grid">
        <div>
          {eyebrow && <p class="eyebrow brass">{eyebrow}</p>}
          <h1 class="t-display" id="hero-h">{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
          {lead && <p class="t-lead">{lead}</p>}
          {buttons.length > 0 && (
            <div class="cluster">
              {buttons.map((button, i) => (
                <a class:list={['btn', i === 0 && 'solid', 'lg']} href={button.url}>
                  {button.label}
                </a>
              ))}
            </div>
          )}
          {heroWaitlist && <WaitlistForm variant="hero" source="hero" />}
        </div>
        <div class="orbit" data-orbit="busy"></div>
      </div>
    </div>
  </section>

  <Sections {sections} source="home.md" />
</BaseLayout>

<script>
  // A query makes this its own copy, so Astro inlines it in the page instead of fetching a shared chunk after the script that imports it.
  // @ts-expect-error the query suffix has no type declaration
  import '../scripts/orbit.js?home';
</script>

<script>
  import '../scripts/hero-fx';
</script>
