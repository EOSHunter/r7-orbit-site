---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlocks from '../components/PageBlocks.astro';
import Search from '../components/Search.astro';
import { navItems } from '../data/nav';
import { loadPage } from '../lib/page-copy-queries';
import { headTitleFor } from '../lib/seo';
import { searchKinds } from '../lib/site-settings';
import { titleParts } from '../lib/text';

// The heading, description and the note for readers without JavaScript are src/content/pages/search.md (edited in /admin,
// "Pages"); every block of it is that note. The search box and the kind links are the page's frame.
const { title, seoTitle, description, sections, contexts } = await loadPage('search');
// The archives, found by address (a label renamed in /admin keeps its chip), labelled and ordered as the nav has them.
const kinds = searchKinds(navItems);
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description} noindex>
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Search</p>
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
    </header>
    <Search page />
    <noscript>
      <PageBlocks blocks={sections} contexts={contexts} paragraphs="search-note" />
    </noscript>
    <ul class="search-kinds" aria-label="Browse by kind">
      {kinds.map((item) => (
        <li>
          <a class="chip" href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
