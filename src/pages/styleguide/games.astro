---
// Fixture for tests/games.spec.js: the games hub drawn with the real components over made-up projects, so the tests do not
// depend on published content. It runs the same helpers as /games/ (selectGames, toGameCards, gamesPageLd) over a mix that
// includes a draft, a future-dated game, a project that is not a game, and `order` values, for zero, one, two and many games.
// Sample content, not part of the site. Not linked from anywhere and kept out of search engines, like the rest of the styleguide.
import GamesSection from '../../components/GamesSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import type { Post } from '../../lib/content';
import { toGameCards } from '../../lib/game-cards';
import { gamesPageLd, selectGames } from '../../lib/games';
import { jsonLdString } from '../../lib/seo';

const URL = 'https://play.example.test/';

function project(id: string, date: string, data: Record<string, unknown> = {}): Post {
  return {
    collection: 'projects',
    id,
    data: {
      title: id.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()),
      summary: `A made-up game called ${id}.`,
      date: new Date(date),
      tags: [],
      featured: false,
      draft: false,
      playUrl: `${URL}${id}/`,
      ...data,
    } as Post['data'],
  };
}

// Newest first by date, so the `order` values (not the dates) are what the tests see deciding the sequence.
const pool: Post[] = [
  project('fixture-newest', '2026-09-30', {
    cover: '/og-default.png',
    coverAlt: 'A fixture poster',
    platforms: ['desktop', 'mobile'],
  }),
  project('fixture-second', '2026-09-20', { order: 2, platforms: ['desktop'] }),
  project('fixture-first', '2026-01-05', {
    order: 1,
    cover: '/og-default.png',
    coverAlt: 'A fixture poster',
    platforms: ['mobile'],
  }),
  project('fixture-link', '2026-08-01', { playMode: 'link', platforms: ['desktop'] }),
  project('fixture-older', '2026-05-01', { cover: '/og-default.png', coverAlt: 'A fixture poster' }),
  project('fixture-draft', '2026-09-01', { draft: true, order: 0 }),
  project('fixture-scheduled', '2099-01-01', { order: 0 }),
  project('fixture-not-a-game', '2026-09-15', { playUrl: undefined, order: 0 }),
];

const NOW = new Date('2026-10-05T12:00:00Z');
const many = selectGames(pool, { now: NOW });
// One, two and none: the first published games of the same selection, so a change in the rules shows in every variant.
const variants = [
  { name: 'none', games: [] as Post[] },
  { name: 'one', games: many.slice(0, 1) },
  { name: 'two', games: many.slice(0, 2) },
  { name: 'many', games: many },
];
---

<BaseLayout title="Games fixture" description="A made-up games hub the tests use. Not part of the site." noindex>
  <script slot="head" type="application/ld+json" set:html={jsonLdString(gamesPageLd(site, many))} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Not part of the site</p>
      <h1>Games fixture</h1>
    </header>
    {variants.map((variant) => (
      <section class="section" data-fixture={variant.name} aria-label={`Fixture: ${variant.name}`}>
        <GamesSection games={toGameCards(variant.games)} />
      </section>
    ))}
  </div>
  <div class="archive-end"></div>
</BaseLayout>
