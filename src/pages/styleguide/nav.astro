---
// Fixture for tests/site-settings.spec.js: a fixed nav (tests/fixtures/site-nav.json: every archive, and Apps in the footer too)
// with every label renamed, the way an author could rename them in /admin (Site settings). The page says it is in the Blog section
// by address (current="/blog/"), so the header must still mark the renamed Blog link as current, every link must still go where
// it did, and the search page's archive chips (searchKinds) must still find the archives. Sample content, not part of the site.
// Not linked from anywhere and kept out of search engines, like the rest of the styleguide.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { searchKinds, type NavItem } from '../../lib/site-settings';
import fixture from '../../../tests/fixtures/site-nav.json';

// Not the site's own nav: the author edits that in /admin, and could take out the Blog or Apps link the tests rename.
const nav = (fixture as NavItem[]).map((item) => ({ ...item, label: `Renamed ${item.label.toLowerCase()}` }));
---

<BaseLayout
  title="Nav fixture"
  description="The site nav with every label renamed, for the tests. Not part of the site."
  noindex
  current="/blog/"
  {nav}
>
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Not part of the site</p>
      <h1>Nav fixture</h1>
    </header>
    <ul class="search-kinds" aria-label="Browse by kind">
      {searchKinds(nav).map((item) => (
        <li>
          <a class="chip" href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
