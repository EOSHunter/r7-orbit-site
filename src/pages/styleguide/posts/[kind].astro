---
// Fixture for tests/post-sections.spec.js: the tests' one post per kind written as sections (tests/fixtures/posts/<kind>/), drawn by
// the same page components as /blog/<slug>/ and the rest (ArticlePage, VlogPage, ProjectPage, RepoPage), through the same schema and
// loaders, so a sections body is checked on every kind of page without a sample post on the site. Sample content, not part of the
// site: noindex, not linked from anywhere, and never in an archive, the sitemap or search.
// Docs: docs/SECTIONS.md ("Posts") and docs/CONTENT_MODEL.md.
import ArticlePage from '../../../components/ArticlePage.astro';
import ProjectPage from '../../../components/ProjectPage.astro';
import RepoPage from '../../../components/RepoPage.astro';
import VlogPage from '../../../components/VlogPage.astro';
import type { CollectionName } from '../../../lib/content';
import { getFixturePosts, type SitePost } from '../../../lib/content-queries';

export function getStaticPaths() {
  const kinds: CollectionName[] = ['news', 'blog', 'vlogs', 'projects', 'repos'];
  return kinds.map((kind) => ({ params: { kind } }));
}

const kind = Astro.params.kind as CollectionName;
const [post] = await getFixturePosts(kind);
if (!post) throw new Error(`tests/fixtures/posts/${kind}/ has no published post: /styleguide/posts/${kind}/ draws it.`);
// Its own kind only, so the related posts, previous/next and "more games" never link to a page that does not exist.
const alone = [post] as SitePost[];
---

{kind === 'blog' || kind === 'news' ? (
  <ArticlePage post={post as SitePost<'blog'>} sameKind={alone as SitePost<'blog'>[]} everything={alone} noindex />
) : kind === 'vlogs' ? (
  <VlogPage post={post as SitePost<'vlogs'>} vlogs={alone as SitePost<'vlogs'>[]} noindex />
) : kind === 'projects' ? (
  <ProjectPage post={post as SitePost<'projects'>} all={alone} games={[]} noindex />
) : (
  <RepoPage post={post as SitePost<'repos'>} all={alone} noindex />
)}
