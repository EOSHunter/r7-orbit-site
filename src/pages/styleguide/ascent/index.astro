---
// Prototype of R7: Ascent (docs/ASCENT.md, phases 1 and 2 of 4). The test climb and the robot agent built in Blender
// (tools/ascent/; a capsule stands in if the robot does not load) and a third-person camera; the feel's numbers are in src/game/ascent/config.ts. The game and its level are loaded when
// Play is pressed, so three.js is a lazy chunk and never in this page's first load. ?level=code plays phase 1's grey boxes
// instead, laid out in code (and so does a failed level load, which the debug readout says). Under the game, a
// debug readout that only this page has. Play puts the stage in full screen and locks the mouse to it, in the click itself
// (game/ascent/gesture.ts): the browser allows neither once the click is over, and the game takes a moment to load. Fixture
// for tests/ascent.spec.js (?lock=0 never asks for pointer lock; ?fullscreen=0 plays in the page; ?start=0 stops on the
// ready screen). Not linked from anywhere and kept out of search engines, like the rest of the styleguide.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ASCENT_TEXT } from '../../../game/ascent/text';
import '../../../game/ascent/ascent.css';

const stats = [
  ['level', 'level'],
  ['agent', 'agent'],
  ['animation', 'animation'],
  ['fps', 'fps'],
  ['steps', 'steps per frame'],
  ['altitude', 'altitude'],
  ['position', 'position'],
  ['speed', 'speed'],
  ['vy', 'vertical speed'],
  ['grounded', 'on the ground'],
  ['coyote', 'coyote left'],
  ['buffer', 'jump buffer left'],
  ['jumps', 'jumps'],
  ['falls', 'falls'],
  ['time', 'time'],
  ['camera', 'camera yaw, pitch, distance'],
  ['locked', 'pointer locked'],
  ['triangles', 'triangles'],
  ['calls', 'draw calls'],
];
---

<BaseLayout
  title="Ascent prototype"
  description="A prototype of R7: Ascent, a 3D climbing game, with a test climb. Not part of the site."
  noindex
>
  <section class="section" aria-labelledby="as-h">
    <div class="container">
      <p class="eyebrow brass">Not part of the site</p>
      <h1 class="t-h1" id="as-h">
        Ascent prototype
      </h1>
      <p class="t-lead">
        The prototype of {ASCENT_TEXT.title}: a short test climb built in Blender, to judge how moving and jumping feel.
        Phase 2 of 4.
      </p>

      <div
        class="as-stage"
        data-ascent-host
        tabindex="0"
        role="application"
        aria-label={`${ASCENT_TEXT.title}, a climbing game`}
        aria-describedby="as-howto"
      >
        <div class="as-poster" data-ascent-poster>
          <button class="btn solid lg" type="button" data-ascent-play>
            Play
          </button>
          <p class="as-needs">Needs a keyboard and a mouse, and WebGL.</p>
          <noscript>
            <p>This game needs JavaScript.</p>
          </noscript>
        </div>
      </div>

      <div class="as-below">
        <div id="as-howto" class="as-howto">
          <p>
            Climb the desk to the brass ring. Play fills the screen and the mouse looks around. W, A, S and D or the
            arrow keys move, relative to the camera. Space jumps: hold it for a full jump, tap it for a short hop. Q and
            E turn the camera from the keyboard. Escape pauses; Escape again leaves full screen. Fall off the world and
            you go back to the start.
          </p>
          <p>
            A jump still counts just after you step off an edge, and a jump pressed just before you land happens when
            you land.
          </p>
        </div>

        <div class="as-debug" data-ascent-debug>
          <p class="eyebrow">Debug</p>
          <dl>
            {stats.map(([key, label]) => (
              <div>
                <dt>{label}</dt>
                <dd data-stat={key}>-</dd>
              </div>
            ))}
          </dl>
          <div class="as-actions">
            <button class="btn sm" type="button" data-ascent-restart hidden>
              Restart
            </button>
            <button class="btn sm" type="button" data-ascent-unmount hidden>
              Unmount the game
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .as-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 16rem;
    margin-top: var(--s-6);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .as-stage:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .as-stage:fullscreen {
    border: 0;
    border-radius: 0;
  }

  .as-poster {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    text-align: center;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  .as-poster p {
    margin: 0;
  }

  .as-below {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }

  .as-howto {
    max-width: 68ch;
    color: var(--text-2);
  }

  .as-howto p {
    margin: 0 0 var(--s-3);
  }

  .as-debug dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-2) 0 var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .as-debug dl div {
    display: flex;
    gap: var(--s-2);
  }

  .as-debug dt {
    color: var(--text-3);
  }

  .as-debug dd {
    margin: 0;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .as-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  @media (min-width: 64rem) {
    .as-below {
      grid-template-columns: 1fr 26rem;
    }
  }
</style>

<script>
  import type { AgentModel, AscentHandle, AscentStats, LevelModel } from '../../../game/ascent/index';
  import { enterPlay } from '../../../game/ascent/gesture';

  const host = document.querySelector<HTMLElement>('[data-ascent-host]');
  const poster = document.querySelector<HTMLElement>('[data-ascent-poster]');
  const play = document.querySelector<HTMLButtonElement>('[data-ascent-play]');
  const restart = document.querySelector<HTMLButtonElement>('[data-ascent-restart]');
  const unmount = document.querySelector<HTMLButtonElement>('[data-ascent-unmount]');
  const out = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-stat]')].map((el) => [el.dataset.stat ?? '', el]),
  );
  const show = (key: string, text: string) => {
    const el = out.get(key);
    if (el) el.textContent = text;
  };

  const query = new URLSearchParams(location.search);
  const options = {
    pointerLock: query.get('lock') !== '0',
    fullscreen: query.get('fullscreen') !== '0',
    start: query.get('start') !== '0',
    level: query.get('level') === 'code' ? 'code' : 'blender',
  };
  let handle: AscentHandle | null = null;
  let loading = false;
  let shownAt = 0;

  // The readout is drawn a few times a second at most: writing to the DOM every frame would cost more than the game.
  const onStats = (s: AscentStats) => {
    const now = performance.now();
    if (now - shownAt < 200) return;
    shownAt = now;
    show('fps', s.fps.toFixed(0));
    show('steps', String(s.steps));
    show('altitude', `${s.altitude.toFixed(2)} m (best ${s.best.toFixed(1)})`);
    show('position', `${s.x.toFixed(2)}, ${s.y.toFixed(2)}, ${s.z.toFixed(2)}`);
    show('speed', `${s.speed.toFixed(2)} m/s`);
    show('vy', `${s.vy.toFixed(2)} m/s`);
    show('grounded', s.grounded ? 'yes' : 'no');
    show('coyote', `${s.coyote.toFixed(3)} s`);
    show('buffer', `${s.buffer.toFixed(3)} s`);
    show('jumps', String(s.jumps));
    show('falls', String(s.falls));
    show('time', `${s.time.toFixed(1)} s`);
    show('camera', `${s.cameraYaw.toFixed(2)}, ${s.cameraPitch.toFixed(2)}, ${s.cameraDistance.toFixed(2)}`);
    show('locked', s.locked ? 'yes' : 'no');
    show('triangles', String(s.view.triangles));
    show('calls', String(s.view.calls));
    show('animation', s.view.animation);
  };

  async function boot() {
    if (!host || handle || loading) return;
    loading = true;
    try {
      const { mountAscent, loadTestClimb, loadAgent } = await import('../../../game/ascent/index');
      const reason = (error: unknown) => (error instanceof Error ? error.message : String(error));
      // The level and the robot load side by side; either may fail on its own and the game still plays.
      const [level, robot] = await Promise.allSettled([
        options.level === 'blender' ? loadTestClimb() : Promise.resolve(null),
        loadAgent(),
      ]);
      let model: LevelModel | null = null;
      if (options.level !== 'blender') show('level', 'grey boxes (code)');
      else if (level.status === 'fulfilled') {
        model = level.value;
        show('level', 'test climb (Blender)');
      } else show('level', `grey boxes (the test climb did not load: ${reason(level.reason)})`);
      let agent: AgentModel | null = null;
      if (robot.status === 'fulfilled') {
        agent = robot.value;
        show('agent', 'robot (Blender)');
      } else show('agent', `capsule (the robot did not load: ${reason(robot.reason)})`);
      handle = mountAscent(host, {
        model,
        agent,
        pointerLock: options.pointerLock,
        fullscreen: options.fullscreen,
        onStats,
      });
      if (options.start) handle.start();
      for (const b of [restart, unmount]) if (b) b.hidden = false;
    } finally {
      loading = false;
      if (poster) poster.hidden = !!handle;
    }
  }

  play?.addEventListener('click', (e) => {
    e.stopPropagation();
    // Now, inside the click: once the game has loaded, the browser would no longer allow either.
    if (host && options.start) enterPlay(host, { lock: options.pointerLock, fullscreen: options.fullscreen });
    if (poster) poster.hidden = true;
    boot();
  });

  restart?.addEventListener('click', () => {
    handle?.restart();
    host?.focus();
  });

  unmount?.addEventListener('click', () => {
    handle?.destroy();
    handle = null;
    for (const b of [restart, unmount]) if (b) b.hidden = true;
    if (poster) poster.hidden = false;
    for (const [key, el] of out) if (key !== 'level' && key !== 'agent') el.textContent = '-';
  });
</script>
