---
// Prototype, not part of the site: three directions for branded article imagery (docs/IMAGE_STYLE.md). Each treatment is CSS and
// inline SVG laid over the real covers, so nothing is baked into an image file and any future picture gets it. The "before" cards
// are the live PostCard; every "after" is markup written by ./_prototype.ts (the live card markup, copied, plus an overlay) styled by
// src/styles/imagery-prototype.css, which only the prototypes import. No live component, card, hero or layout changes.
// Round 2 (variety, the editor's picker, branding in the words) is ./v2.astro.
// Not linked from anywhere and kept out of search engines, like the rest of the styleguide.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import {
  MOTION,
  card,
  dial,
  eclipse,
  focusStyle,
  hero,
  loadSpecimens,
  media,
  noImage,
  og,
  transit,
  withoutCover,
  type DirectionId,
  type Specimen,
} from './_prototype';
import '../../../styles/imagery-prototype.css';

const { pinned, builtBlog, vlogGame, vlogTen, vesper } = await loadSpecimens();
const grid = [builtBlog, vlogGame, vlogTen, vesper].filter((s): s is Specimen => !!s);
const lead = pinned ?? grid[0] ?? noImage;
const ogSpecimens = [lead, vesper && vesper !== lead ? vesper : undefined, noImage].filter((s): s is Specimen => !!s);

const DIRECTIONS: { id: DirectionId; name: string; label: string; recommended?: boolean; idea: string }[] = [
  {
    id: 'transit',
    name: 'Transit',
    label: 'Direction A',
    recommended: true,
    idea: 'One arc of the orbit crosses the corner of every picture, with the dot riding on it. The picture keeps its own colour; a tighter crop and a dark veil in the corner make it read.',
  },
  {
    id: 'eclipse',
    name: 'Eclipse',
    label: 'Direction B',
    idea: 'The picture becomes the planet: a circular crop with the brand ring passing behind it and in front of it, like the logo, on a blurred plate of the same picture.',
  },
  {
    id: 'dial',
    name: 'Dial',
    label: 'Direction C',
    idea: 'Every picture gets the house grade, obsidian and brass, with orbit lines etched over it like an instrument dial. Its own colour comes back on hover.',
  },
];
---

<BaseLayout title="Article imagery prototype" description="Three directions for branded article images. A prototype, not part of the site." noindex>
  {/* The ring paths, once for the page; every overlay draws them with <use>. */}
  <svg class="ix-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <path id="ix-transit-ring" d={transit.d} vector-effect="non-scaling-stroke"></path>
      <path id="ix-transit-track" d={transit.d} pathLength="100"></path>
      <path id="ix-eclipse-back" d={eclipse.back} vector-effect="non-scaling-stroke"></path>
      <path id="ix-eclipse-front" d={eclipse.front} vector-effect="non-scaling-stroke"></path>
      <path id="ix-eclipse-track" d={eclipse.d} pathLength="100"></path>
      {dial.map((o, i) => <path id={`ix-dial-ring-${i}`} d={o.d} vector-effect="non-scaling-stroke"></path>)}
      <path id="ix-dial-track" d={dial[1].d} pathLength="100"></path>
      <filter id="ix-glow" x="-10%" y="-30%" width="120%" height="160%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
    </defs>
  </svg>

  <div class="container">
    <header class="page-head">
      <p class="eyebrow brass">Prototype · not part of the site</p>
      <h1>Article imagery</h1>
      <p class="t-lead text-2">
        Three directions for how every article picture could look: the cards at the sizes the site uses, the article hero, the
        share image, and a post with no picture. Each treatment is CSS and SVG laid over the real covers. Nothing is baked into
        an image.
      </p>
      <p class="text-3">Hover or tab to a card to see the dot move. The brief, the rules and the rollout plan are in docs/IMAGE_STYLE.md.</p>
      <nav aria-label="Directions">
        <ul class="ix-toc">
          {DIRECTIONS.map((d) => (
            <li>
              <a href={`#${d.id}`}>
                <span class="ix-toc-label">{d.label}{d.recommended && ' · recommended'}</span>
                <span class="ix-toc-name">{d.name}</span>
                <span class="ix-toc-idea">{d.idea}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
  </div>

  {DIRECTIONS.map((dir) => (
    <section class={`section ruled ix ix-${dir.id}`} id={dir.id} aria-labelledby={`${dir.id}-h`} style={MOTION[dir.id]}>
      <div class="container">
        <div class="ix-head">
          <p class="eyebrow brass">{dir.label}{dir.recommended && ' · recommended'}</p>
          <h2 class="section-title" id={`${dir.id}-h`}>{dir.name}</h2>
          <p class="text-2">{dir.idea}</p>
        </div>

        <h3 class="ix-h">Before and after</h3>
        <div class="ix-pair">
          <figure class="ix-figure">
            <figcaption class="eyebrow">Before: today</figcaption>
            <PostCard post={lead.card} />
          </figure>
          <figure class="ix-figure">
            <figcaption class="eyebrow brass">After: {dir.name}</figcaption>
            <Fragment set:html={card(dir.id, lead)} />
          </figure>
        </div>

        <h3 class="ix-h">Pinned card (home)</h3>
        <Fragment set:html={card(dir.id, lead, ' featured pinned', 'pinned')} />

        <h3 class="ix-h">Archive and related cards</h3>
        <div class="grid-cards">
          {grid.map((s) => <Fragment set:html={card(dir.id, s)} />)}
        </div>

        <h3 class="ix-h" id={dir.id === 'transit' ? 'no-image' : `${dir.id}-no-image`}>No picture</h3>
        <div class="grid-cards">
          <Fragment set:html={card(dir.id, noImage)} />
          {vesper && <Fragment set:html={card(dir.id, withoutCover(vesper))} />}
        </div>

        <h3 class="ix-h">States: rest, hover, keyboard focus</h3>
        <div class="ix-states">
          {['rest', 'hover', 'focus'].map((state) => (
            <figure class="ix-figure">
              <figcaption class="eyebrow">{state}</figcaption>
              <Fragment set:html={card(dir.id, lead, ` ix-state-${state}`, 'card', state === 'rest' ? '' : ' tabindex="-1"')} />
            </figure>
          ))}
        </div>

        <h3 class="ix-h">Thumbnail test: 320 × 180 and 160 × 90</h3>
        <div class="ix-thumbs">
          {[...grid.slice(0, 2), noImage].map((s) => <div class="ix-thumb" style={focusStyle(s)} set:html={media(dir.id, s, 'thumb')} />)}
        </div>
        <div class="ix-thumbs ix-micros">
          {[...grid.slice(0, 2), noImage].map((s) => <div class="ix-thumb ix-micro" style={focusStyle(s)} set:html={media(dir.id, s, 'micro')} />)}
        </div>

        <h3 class="ix-h">Article hero</h3>
      </div>
      <Fragment set:html={hero(dir.id, lead)} />

      <div class="container">
        <h3 class="ix-h">Share image (og:image, 1200 × 630)</h3>
        <div class="ix-og-list">
          {ogSpecimens.map((s) => <Fragment set:html={og(dir.id, s)} />)}
        </div>
      </div>
    </section>
  ))}
  <div class="archive-end"></div>
</BaseLayout>
