---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/text';

const description = `Get an email when ${site.name} publishes something new. A few times a month, and one click to leave.`;
const base = Astro.site ?? new URL(site.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Subscribe', item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
};
---

<BaseLayout title="Subscribe" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Newsletter</p>
      <h1>
        One email when something new is <em>worth reading</em>
      </h1>
      <p class="t-lead">New posts and videos from {site.name}, a few times a month. Nothing else.</p>
    </header>

    <div class="subscribe">
      <div>
        <h2 id="subscribe-h">What you'll get</h2>
        <p>
          A short email each time a post, video, project or repo goes up, with a line on why it's worth your time. You
          can leave in one click.
        </p>
        <p>
          Prefer a feed reader? <a href={site.links.rss}>The RSS feed</a> has everything the email does.
        </p>
      </div>
      <NewsletterForm id="subscribe-page" />
    </div>

    <p class="t-meta" style="padding-block: var(--s-5) var(--s-8)">
      What happens to your address is explained in plain words on the <a href="/privacy/">privacy page</a>.
    </p>
  </div>
</BaseLayout>
