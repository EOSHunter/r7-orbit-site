---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { site } from '../data/site';
import { subscribeSlots } from '../lib/page-copy';
import { loadPage } from '../lib/page-copy-queries';
import { headTitleFor } from '../lib/seo';
import { absoluteUrl, titleParts } from '../lib/text';

// The words are src/content/pages/subscribe.md (edited in /admin, "Pages"); the eyebrow and the form are the page's frame.
// Where each block sits: subscribeSlots in src/lib/page-copy.ts.
const { title, seoTitle, description, sections, contexts } = await loadPage('subscribe');
const { lead, beside, after } = subscribeSlots(sections);
const base = Astro.site ?? new URL(site.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Subscribe', item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
};
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '<')} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Newsletter</p>
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <PageBlocks blocks={lead} contexts={contexts} lead="t-lead" />
    </header>

    <div class="subscribe">
      <div>
        <PageBlocks blocks={beside} contexts={contexts} />
      </div>
      <NewsletterForm id="subscribe-page" />
    </div>

    <div style="padding-block: var(--s-5) var(--s-8)">
      <PageBlocks blocks={after} contexts={contexts} paragraphs="t-meta" />
    </div>
  </div>
</BaseLayout>
