---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import AuthorNote from '../../components/AuthorNote.astro';
import Icon from '../../components/Icon.astro';
import PreviewBadge from '../../components/PreviewBadge.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectJsonLd from '../../components/ProjectJsonLd.astro';
import ReadmeBlock from '../../components/ReadmeBlock.astro';
import StatsRow from '../../components/StatsRow.astro';
import SubscribeBand from '../../components/SubscribeBand.astro';
import { toCard, type RepoData } from '../../components/detailCards';
import { authorSlugOf } from '../../lib/authors';
import { getAuthorMap } from '../../lib/authors-queries';
import { getAllPosts, getPosts, type SitePost } from '../../lib/content-queries';
import { relatedPosts } from '../../lib/content';
import { loadGitHubRepo } from '../../lib/github';
import { headTitleFor } from '../../lib/seo';
import { longDate } from '../../lib/text';
import '../../styles/markdown.css';

export async function getStaticPaths() {
  const repos = await getPosts('repos');
  return repos.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: SitePost<'repos'>;
}

const { post } = Astro.props;
const data = post.entry.data as unknown as RepoData;
const [owner, name] = data.repo.split('/');
const githubUrl = `https://github.com/${data.repo}`;
const cloneCommand = data.install ?? `git clone ${githubUrl}.git`;

// Never throws: either data (fresh or cached) or `unavailable`, and the page reads fine in both cases.
const gh = await loadGitHubRepo(data.repo);
const stats = gh.status === 'ok' ? gh.stats : undefined;
const homepage = data.homepage ?? stats?.homepage ?? undefined;

const hasBody = Boolean(post.body?.trim());
const { Content } = hasBody ? await render(post.entry) : { Content: undefined };
const useLocal = data.readme === 'local';
const readmeHtml = gh.status === 'ok' ? gh.readmeHtml : null;

const all = await getAllPosts();
const related = relatedPosts(post, all);
const path = `/repos/${post.id}/`;
const author = (await getAuthorMap()).get(authorSlugOf(post))!;
---

<BaseLayout
  title={headTitleFor(data.repo, data.seoTitle)}
  description={data.summary}
  current="Repos"
  published={data.date}
  modified={data.updated}
  tags={data.tags}
>
  <ProjectJsonLd
    slot="head"
    kind="repo"
    name={data.repo}
    description={data.summary}
    path={path}
    published={data.date}
    modified={stats?.pushedAt ?? data.updated}
    keywords={[...(stats?.topics ?? []), ...data.tags]}
    codeRepository={githubUrl}
    language={stats?.language}
    license={stats?.license}
    author={author}
  />
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/repos/">Repos</a></li>
        <li aria-current="page">{data.repo}</li>
      </ol>
    </nav>

    <header class="repo-head">
      <p class="eyebrow">
        <span class="kind"><Icon name="repo" />Repo</span>
        <PreviewBadge post={post} />
      </p>
      <h1 class="repo-name"><span class="owner">{owner}/</span><wbr />{name}</h1>
      <p class="t-lead">{data.summary}</p>
      <p class="post-author"><AuthorByline author={author} /></p>
      {stats && <StatsRow language={stats.language} stars={stats.stars} forks={stats.forks} pushedAt={stats.pushedAt} />}
      <div class="cluster actions">
        <a class="btn solid" href={githubUrl} rel="noopener">
          <Icon name="github" />View on GitHub<Icon name="external" />
        </a>
        <button class="btn" type="button" data-copy={cloneCommand}>
          <Icon name="copy" /><span data-copy-label>Copy clone command</span>
        </button>
      </div>
    </header>

    <div class="split">
      <div>
        {
          Content && (
            <section class="block" aria-label="Notes">
              <div class="prose">
                <Content />
              </div>
            </section>
          )
        }

        {
          !(useLocal && hasBody) && (
            <section class="block" aria-labelledby="readme-h">
              <h2 class="visually-hidden" id="readme-h">README</h2>
              {readmeHtml ? (
                <ReadmeBlock html={readmeHtml} />
              ) : (
                <div class="callout">
                  {gh.status === 'ok'
                    ? 'This repository has no README yet. '
                    : 'The README could not be loaded when this page was built. '}
                  <a href={githubUrl} rel="noopener">Read it on GitHub</a>.
                </div>
              )}
            </section>
          )
        }

        <AuthorNote author={author} />
      </div>

      <aside class="sticky" aria-label="Repository facts">
        <div class="facts">
          <h2 class="eyebrow">Facts</h2>
          <dl>
            <div>
              <dt>Repository</dt>
              <dd><a href={githubUrl} rel="noopener">{data.repo}<Icon name="external" small /></a></dd>
            </div>
            {
              homepage && (
                <div>
                  <dt>Website</dt>
                  <dd><a href={homepage} rel="noopener">{new URL(homepage).hostname}<Icon name="external" small /></a></dd>
                </div>
              )
            }
            {stats?.license && <div><dt>License</dt><dd>{stats.license}</dd></div>}
            {stats?.language && <div><dt>Language</dt><dd><span class="lang">{stats.language}</span></dd></div>}
            {
              stats && stats.topics.length > 0 && (
                <div>
                  <dt>Topics</dt>
                  <dd>
                    <div class="cluster">
                      {stats.topics.map((topic) => (
                        <span class="chip mono">{topic}</span>
                      ))}
                    </div>
                  </dd>
                </div>
              )
            }
            {stats && <div><dt>Branch</dt><dd class="mono">{stats.defaultBranch}</dd></div>}
          </dl>
        </div>
        {gh.status === 'ok' && <p class="t-meta">Stats from GitHub as of {longDate(gh.fetchedAt)}.</p>}
      </aside>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section ruled" aria-labelledby="related-h">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Writing and video</p>
              <h2 class="section-title" id="related-h">Posts about this repo</h2>
            </div>
          </div>
          <div class="grid-cards">
            {related.map((item) => (
              <PostCard post={toCard(item)} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <SubscribeBand />
</BaseLayout>
