---
import RepoPage from '../../components/RepoPage.astro';
import { getAllPosts, getPosts } from '../../lib/content-queries';

export async function getStaticPaths() {
  const repos = await getPosts('repos');
  const all = await getAllPosts();
  return repos.map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}

const { post, all } = Astro.props;
---

<RepoPage post={post} all={all} />
