---
// The content manager. A bare page on purpose: no site header, footer or search, and it is kept out of
// the sitemap, robots.txt and search (README "Admin"). Decap builds its own UI inside #nc-root.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content manager</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      /* Decap marks every field that is not always required "(optional)". Alt text is required whenever its picture is set
         (src/admin/image-alt.ts), so its boxes do not say optional. Decap's field ids are `<name>-field-<n>`. */
      label[for^='coverAlt-field-'] > span,
      label[for^='featuredImageAlt-field-'] > span {
        display: none;
      }
    </style>
  </head>
  <body>
    <noscript>The content manager needs JavaScript.</noscript>
    <script>
      import '../../admin/main';
    </script>
  </body>
</html>
