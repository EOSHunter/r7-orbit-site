---
// The content manager. A bare page on purpose: no site header, footer, search or theme script, and it is kept out of
// the sitemap, robots.txt, search and feeds (README "Admin"). Decap builds its own UI inside #nc-root.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content manager</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <noscript>The content manager needs JavaScript.</noscript>
    <p id="admin-unconfigured" hidden>
      Sign-in is not set up. Set <code>PUBLIC_CMS_AUTH_URL</code> when building the site (see "Admin" in the README), or
      run <code>npm run dev</code> and <code>npm run cms</code> to edit locally.
    </p>
    <script>
      import '../../admin/main';
    </script>
  </body>
</html>
