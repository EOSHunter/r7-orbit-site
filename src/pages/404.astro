---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageBlocks from '../components/PageBlocks.astro';
import RunnerStage from '../components/RunnerStage.astro';
import { lostSlots } from '../lib/page-copy';
import { loadPage } from '../lib/page-copy-queries';
import { headTitleFor } from '../lib/seo';
import { titleParts } from '../lib/text';

// The words are src/content/pages/404.md (edited in /admin, "Pages"). The orbit, the search box and the two buttons are the
// page's frame. The host serves this file with a 404 status for any unknown address, and the page is noindex.
const { title, seoTitle, description, sections, contexts } = await loadPage('404');
const { lead, body } = lostSlots(sections);
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description} noindex>
  <section class="plate-grid">
    <div class="container wide">
      <div class="lost">
        <!-- A quiet orbit: the dot drifts, nothing is working. -->
        <div class="orbit" data-orbit></div>
        <p class="eyebrow brass">Error 404</p>
        <h1 class="t-display">{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
        <PageBlocks blocks={lead} contexts={contexts} lead="t-lead" />
        <PageBlocks blocks={body} contexts={contexts} />
        <form class="search-form" role="search" action="/search/" method="get" aria-label="Search the site">
          <div class="search">
            <Icon name="search" />
            <label class="visually-hidden" for="lost-search">
              Search posts
            </label>
            <input
              class="input"
              id="lost-search"
              type="search"
              name="q"
              placeholder="Search posts"
              autocomplete="off"
            />
          </div>
          <button class="btn solid" type="submit">
            Search
          </button>
        </form>
        <div class="cluster">
          <a class="btn" href="/">
            <Icon name="arrow" class="flip" />
            Back home
          </a>
          <a class="btn" href="/#latest">
            See the latest
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <RunnerStage />
  <script>
    // A query makes this its own copy, so Astro inlines it in the page instead of fetching a shared chunk after the script that imports it.
    // @ts-expect-error the query suffix has no type declaration
    import '../scripts/orbit.js?lost';
  </script>
</BaseLayout>
