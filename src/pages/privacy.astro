---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { absoluteUrl, longDate } from '../lib/text';

const description = `What ${site.name} collects about you (nothing by itself), where the newsletter form goes, and how to unsubscribe.`;
const base = Astro.site ?? new URL(site.url);
// The newsletter paragraphs follow the one setting that decides where the form goes (src/lib/newsletter.ts).
const connected = Boolean(site.newsletter.formAction);
const provider = site.newsletter.provider;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Privacy', item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
};
---

<BaseLayout title="Privacy" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Privacy</p>
      <h1>
        What this site <em>knows about you</em>
      </h1>
      <p class="t-lead">Almost nothing. This page says what, and why.</p>
    </header>

    <div class="prose" style="padding-bottom: var(--s-8)">
      <h2>The short version</h2>
      <p>
        This site has no analytics, no advertising, no comments and no cookies. Pages don't load anything from other
        companies: the fonts, icons and scripts all come from this site. I don't know who reads it or how many do.
      </p>

      <h2>What stays on your device</h2>
      <p>This site does not save anything in your browser's local storage or cookies.</p>

      <h2>The newsletter</h2>
      {connected ? (
        <>
          <p>
            If you subscribe, your email address is sent to <strong>{provider}</strong>, the service that stores the
            list and sends the emails. I use it to tell you when something new is published, and for nothing else. That
            is the only time the form contacts anyone: the request is made when you press Subscribe, not when the page
            loads.
          </p>
          <p>
            Every email has an unsubscribe link. Using it removes you from the list. You can also write to me and I'll
            remove you by hand.
          </p>
        </>
      ) : (
        <>
          <p>
            The newsletter isn't connected yet. The sign-up form on this site does not send your address anywhere, and
            nothing is stored. When it is connected, this page will name the service that holds the list.
          </p>
          <p>
            Until then, you can follow by <a href={site.links.rss}>RSS</a>, which needs no address at all.
          </p>
        </>
      )}

      <h2>Videos and links to other sites</h2>
      <p>
        A video on this site shows a still image first and loads from YouTube only after you press play. Links to other
        sites, including YouTube, take you away from this one, and their own privacy rules apply there.
      </p>

      <h2>Server logs</h2>
      <p>
        Like any website, whatever serves these pages can see the address and browser details of each request. I don't
        use those logs to follow anyone.
      </p>

      <h2>Contact</h2>
      <p>
        Questions, or a request to remove your address: <a href={`mailto:${site.author.email}`}>{site.author.email}</a>.
      </p>

      <p class="t-meta">Last updated {longDate('2026-10-03')}.</p>
    </div>
  </div>
</BaseLayout>
