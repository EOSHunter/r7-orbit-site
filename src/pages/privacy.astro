---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { site } from '../data/site';
import { privacySlots } from '../lib/page-copy';
import { loadPage } from '../lib/page-copy-queries';
import { headTitleFor } from '../lib/seo';
import { absoluteUrl, titleParts } from '../lib/text';

// The policy is src/content/pages/privacy.md (edited in /admin, "Pages"). The contact email, the RSS address and the newsletter
// provider are tokens filled from src/data/site.json, and the newsletter paragraphs follow the one setting that decides where the
// form goes (`{if newsletter connected}`, src/lib/page-copy.ts), so the settings stay the single place for them.
const { title, seoTitle, description, sections, contexts } = await loadPage('privacy');
const { lead, body, after } = privacySlots(sections);
const base = Astro.site ?? new URL(site.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Privacy', item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
};
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '<')} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Privacy</p>
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <PageBlocks blocks={lead} contexts={contexts} lead="t-lead" />
    </header>

    <div class="prose" style="padding-bottom: var(--s-8)">
      <PageBlocks blocks={body} contexts={contexts} />
      <PageBlocks blocks={after} contexts={contexts} paragraphs="t-meta" />
    </div>
  </div>
</BaseLayout>
