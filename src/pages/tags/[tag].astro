---
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import SubscribeBand from '../../components/SubscribeBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authorsWithPosts } from '../../lib/authors';
import { getAuthors } from '../../lib/authors-queries';
import { postsWithTag, tagsWithPages } from '../../lib/content';
import { getAllPosts } from '../../lib/content-queries';
import { breadcrumbLd, collectionPageLd, jsonLdString } from '../../lib/seo';
import { site } from '../../data/site';
import { KINDS, countLabel } from '../../lib/listing';
import { toCards } from '../../lib/post-cards';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return tagsWithPages(posts).map((tag) => ({ params: { tag }, props: { posts: postsWithTag(posts, tag) } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const cards = await toCards(posts, { filterable: true });
const authors = authorsWithPosts(await getAuthors(), posts);
const description = `${countLabel(posts.length, 'post', 'posts')} tagged ${tag}: news, writing, videos, projects and repos, newest first.`;
const ld = [
  collectionPageLd(site, { path: `/tags/${tag}/`, name: `Posts tagged ${tag}`, description }),
  breadcrumbLd(site, [{ name: 'Tags', path: '/tags/' }, { name: String(tag) }]),
];

// Grouped by kind, kinds in the site's order, newest first inside each group.
const groups = KINDS.map((info) => ({
  info,
  cards: cards.filter((_, i) => posts[i]?.collection === info.collection),
})).filter((g) => g.cards.length > 0);
---

<BaseLayout
  title={`Posts tagged ${tag}`}
  {description}
>
  <script slot="head" type="application/ld+json" set:html={jsonLdString(ld)} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">
        <a href="/tags/">Tags</a>
      </p>
      <h1>
        Posts tagged <em>{tag}</em>
      </h1>
      <p class="t-lead">{countLabel(posts.length, 'post', 'posts')}, newest first within each kind.</p>
    </header>

    {authors.length > 1 && (
      <div class="toolbar" role="group" aria-label="Filter posts" data-author-filter>
        <div class="toolbar-row">
          <span class="eyebrow" id="authors-label">By author</span>
          <div class="seg" role="group" aria-labelledby="authors-label" data-filter="author">
            <button class="on" type="button" data-value="all" aria-pressed="true">All</button>
            {authors.map((a) => (
              <button type="button" data-value={a.slug} aria-pressed="false">
                {a.name}
              </button>
            ))}
          </div>
        </div>
        <p class="t-meta toolbar-count" data-count data-total={posts.length} aria-live="polite">{countLabel(posts.length, 'post', 'posts')}</p>
      </div>
    )}

    {groups.map(({ info, cards: group }) => (
      <section class="block" aria-labelledby={`${info.collection}-h`} data-group>
        <h2 class="section-title tag-group" id={`${info.collection}-h`}>
          <span class="kind">
            <Icon name={info.icon} />
            {info.label}
          </span>
          <span class="t-meta">{countLabel(group.length, info.nounOne, info.noun)}</span>
        </h2>
        <div class="grid-cards">
          {group.map((post) => <PostCard {post} />)}
        </div>
      </section>
    ))}

    <p class="tag-back">
      <a class="more-link" href="/tags/">
        <Icon name="arrow" class="flip" />
        All tags
      </a>
    </p>
  </div>
  <div class="archive-end"></div>
  <SubscribeBand />
</BaseLayout>

<script>
  // The "By author" filter: hides the cards of other authors, and a kind's heading once none of its cards is left. The choice is kept
  // in the address (?author=r7). Without JavaScript the toolbar is hidden and every card shows, like the archive toolbars.
  const bar = document.querySelector<HTMLElement>('[data-author-filter]');
  if (bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter="author"] button')];
    const count = bar.querySelector<HTMLElement>('[data-count]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const apply = (author: string): void => {
      let shown = 0;
      for (const el of items) {
        el.hidden = author !== 'all' && el.dataset.author !== author;
        if (!el.hidden) shown++;
      }
      for (const group of groups) group.hidden = !group.querySelector('[data-item]:not([hidden])');
      for (const b of buttons) {
        const on = (b.dataset.value ?? 'all') === author;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      const total = Number(count?.dataset.total) || items.length;
      if (count) count.textContent = author === 'all' ? `${total} ${total === 1 ? 'post' : 'posts'}` : `${shown} of ${total} posts`;
      const query = author === 'all' ? '' : `?author=${encodeURIComponent(author)}`;
      try {
        history.replaceState(null, '', location.pathname + query + location.hash);
      } catch {
        /* a sandboxed frame: the filter still works, it just is not shareable */
      }
    };
    bar.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      if (b) apply(b.dataset.value ?? 'all');
    });
    const wanted = new URLSearchParams(location.search).get('author') ?? 'all';
    apply(buttons.some((b) => b.dataset.value === wanted) ? wanted : 'all');
  }
</script>
