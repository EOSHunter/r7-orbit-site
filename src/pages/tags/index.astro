---
// Every tag in use. Its words are src/content/pages/tags.md (edited in /admin, "Pages" > Tags page): the heading, lead, browser
// title and description, the empty state, and blocks above and below the list. The chips and "Used once" are code.
import Sections from '../../components/Sections.astro';
import TagIndex from '../../components/TagIndex.astro';
import SubscribeBand from '../../components/SubscribeBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagCounts } from '../../lib/content';
import { getAllPosts } from '../../lib/content-queries';
import { breadcrumbLd, collectionPageLd, headTitleFor, jsonLdString } from '../../lib/seo';
import { loadSitePage } from '../../lib/site-pages-queries';
import { titleParts } from '../../lib/text';
import { site } from '../../data/site';

const posts = await getAllPosts();
const counts = tagCounts(posts);
const entry = await loadSitePage('tags');
const { label } = entry;
const { title, seoTitle, description, introSections, outroSections } = entry.data;
const list = { counts, emptyHeading: entry.text('emptyHeading'), emptyText: entry.text('emptyText') };
const ld = [
  collectionPageLd(site, { path: '/tags/', name: label, description }),
  breadcrumbLd(site, [{ name: label }]),
];
---

<BaseLayout
  title={headTitleFor(title, seoTitle)}
  {description}
  noindex={counts.length === 0}
>
  <script slot="head" type="application/ld+json" set:html={jsonLdString(ld)} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">{label}</p>
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <p class="t-lead">{entry.text('lead')}</p>
    </header>

    {introSections.length === 0 && <TagIndex {...list} />}
  </div>
  {
    introSections.length > 0 && (
      <>
        <Sections sections={introSections} source="tags.md (introSections)" />
        <div class="container wide">
          <TagIndex {...list} />
        </div>
      </>
    )
  }
  {outroSections.length > 0 && <Sections sections={outroSections} source="tags.md (outroSections)" />}
  <div class="archive-end"></div>
  <SubscribeBand />
</BaseLayout>
