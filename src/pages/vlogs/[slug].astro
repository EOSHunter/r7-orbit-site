---
import VlogPage from '../../components/VlogPage.astro';
import { getPosts } from '../../lib/content-queries';

export async function getStaticPaths() {
  const vlogs = await getPosts('vlogs');
  return vlogs.map((post) => ({ params: { slug: post.id }, props: { post, vlogs } }));
}

const { post, vlogs } = Astro.props;
---

<VlogPage post={post} vlogs={vlogs} />
