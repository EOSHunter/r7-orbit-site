---
import ProjectPage from '../../components/ProjectPage.astro';
import { getAllPosts, getApps, getPosts } from '../../lib/content-queries';

export async function getStaticPaths() {
  const projects = await getPosts('projects');
  const all = await getAllPosts();
  const apps = await getApps();
  return projects.map((post) => ({ params: { slug: post.id }, props: { post, all, apps } }));
}

const { post, all, apps } = Astro.props;
---

<ProjectPage post={post} all={all} apps={apps} />
