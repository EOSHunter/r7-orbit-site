---
// /newsletter/: what the newsletter is, and the big sign-up form (docs/NEWSLETTER.md). A dynamic route only so that it is not
// built at all while the newsletter is off: then /newsletter/ is the site's 404 page, like any address that does not exist.
// Its words are src/content/pages/newsletter.md (edited in /admin, "Pages"): the Lead paragraphs go under the heading, above the
// form; the rest follows the form, one reading column. The form's words are Site settings > Newsletter.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import PageBlocks from '../../components/PageBlocks.astro';
import { site } from '../../data/site';
import { splitLead } from '../../lib/page-copy';
import { loadPage } from '../../lib/page-copy-queries';
import { newsletter } from '../../lib/newsletter-queries';
import { headTitleFor } from '../../lib/seo';
import { absoluteUrl, titleParts } from '../../lib/text';

export function getStaticPaths() {
  return newsletter.show ? [{ params: { page: undefined } }] : [];
}

const { title, seoTitle, description, sections, contexts } = await loadPage('newsletter');
const { lead, rest } = splitLead(sections);
const base = Astro.site ?? new URL(site.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
    { '@type': 'ListItem', position: 2, name: 'Newsletter', item: absoluteUrl(Astro.url.pathname, base.href) },
  ],
};
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <div class="container wide">
    <header class="page-head">
      <p class="eyebrow brass">Newsletter</p>
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
      <PageBlocks blocks={lead} contexts={contexts} lead="t-lead" />
    </header>

    <div class="newsletter-page">
      <NewsletterForm id="newsletter" variant="page" />
      <p class="t-meta">
        <a href={newsletter.archive} rel="noopener">
          Past issues
        </a>
      </p>
    </div>

    <div class="prose" style="padding-bottom: var(--s-8)">
      <PageBlocks blocks={rest} contexts={contexts} />
    </div>
  </div>
</BaseLayout>
