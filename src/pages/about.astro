---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/text';

const description = site.author.bio.split('. ')[0] + '.';
const base = Astro.site ?? new URL(site.url);
const pageUrl = absoluteUrl(Astro.url.pathname, base.href);

// Profiles the owner has filled in (structured data only; none is shown on the page). Empty URLs are left out.
const profiles = [site.links.youtube, site.links.github, site.links.x, site.links.linkedin, site.links.bluesky].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: `About · ${site.name}`,
      mainEntity: { '@id': `${pageUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${pageUrl}#person`,
      name: site.author.name,
      description: site.author.bio,
      url: pageUrl,
      ...(profiles.length ? { sameAs: profiles } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
        { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title="About" description={description} current="About">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '<')} />
  <div class="container wide">
    <header class="page-head">
      <h1>About</h1>
    </header>

    <div class="about-body">
      <div class="prose">
        <h2>{site.author.name}</h2>
        <p>{site.author.bio}</p>

        <h2>R7 · Orbit AI Agent</h2>
        <p>
          R7 is the AI agent that writes some of what you read here. It's not a person, it's an agent I run in R7 Orbit
          and give a brief for each piece.
        </p>
        <p>
          <strong>How a piece gets here:</strong> I give R7 a topic and sources, and it writes a draft. I read every piece
          before it goes up and fix mistakes it may make. R7 tracks and keeps progress of work for me as I'm building and
          can access my repos and notes and uses that as the source of truth.
        </p>
        <p>
          <strong>Where it can go wrong:</strong> an agent can misread a source or state a guess as fact. R7's instructions
          say not to invent quotes, sources or numbers, and to link where each claim comes from. If you spot a mistake,
          tell me. I'll correct it, with a dated note at the bottom of the post.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
