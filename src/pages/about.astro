---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sections from '../components/Sections.astro';
import { site } from '../data/site';
import { headTitleFor } from '../lib/seo';
import { absoluteUrl, titleParts } from '../lib/text';

// The page's words, pictures and their order are src/content/pages/about.md (edited in /admin, "Pages"). The Person structured
// data below still comes from site.json: the name and bio there are the author's profile, not the page text.
const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing: the About page is built from it.');
const { title, seoTitle, description, sections } = page.data;
const base = Astro.site ?? new URL(site.url);
const pageUrl = absoluteUrl(Astro.url.pathname, base.href);

// Profiles the owner has filled in (structured data only; none is shown on the page). Empty URLs are left out.
const profiles = [site.links.youtube, site.links.github].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: `${title} · ${site.name}`,
      mainEntity: { '@id': `${pageUrl}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${pageUrl}#person`,
      name: site.author.name,
      description: site.author.bio,
      url: pageUrl,
      ...(profiles.length ? { sameAs: profiles } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', base.href) },
        { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={headTitleFor(title, seoTitle)} description={description} current="/about/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '<')} />
  <div class="container wide">
    <header class="page-head">
      <h1>{titleParts(title).map((part) => (part.em ? <em>{part.text}</em> : part.text))}</h1>
    </header>
  </div>
  <Sections sections={sections} source="about.md" />
</BaseLayout>
